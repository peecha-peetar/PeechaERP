<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="income_statement" pageWidth="595" pageHeight="842"
              columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail">

    <!-- طبقِ رفعِ باگِ فونت در Spike: فقط یک style پیش‌فرض با fontName="Vazirmatn"
         کافی است. طبقِ رفعِ باگِ ارتفاعِ متنِ Bold: تایتلِ ۱۶pt حداقل به
         ارتفاعِ ۳۰ نیاز دارد وگرنه کاملاً نامرئی رندر می‌شود. -->
    <style name="Default" isDefault="true" fontName="Vazirmatn" fontSize="8.5"/>
    <style name="Title" fontName="Vazirmatn" fontSize="16" isBold="true"/>
    <style name="SubTitle" fontName="Vazirmatn" fontSize="10"/>
    <style name="Header" fontName="Vazirmatn" fontSize="8.5" isBold="true"/>
    <style name="Footer" fontName="Vazirmatn" fontSize="7"/>
    <style name="TotalsLabel" fontName="Vazirmatn" fontSize="10" isBold="true"/>

    <parameter name="companyName" class="java.lang.String"/>
    <parameter name="dateRangeLabel" class="java.lang.String"/>
    <parameter name="generatedAt" class="java.lang.String"/>
    <parameter name="netIncomeLabel" class="java.lang.String"/>
    <parameter name="netIncomeDisplay" class="java.lang.String"/>

    <field name="account_code" class="java.lang.String"/>
    <field name="account_name" class="java.lang.String"/>
    <field name="category_label" class="java.lang.String"/>
    <field name="current_amount_display" class="java.lang.String"/>
    <field name="previous_amount_display" class="java.lang.String"/>

    <pageHeader>
        <band height="72">
            <staticText>
                <reportElement style="Title" x="0" y="0" width="535" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <text><![CDATA[صورتِ سود و زیان]]></text>
            </staticText>
            <textField>
                <reportElement style="SubTitle" x="0" y="32" width="535" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$P{companyName}
                    + ($P{dateRangeLabel} != null && !$P{dateRangeLabel}.isEmpty() ? "  —  " + $P{dateRangeLabel} : "")]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Footer" x="0" y="54" width="535" height="16"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["تاریخِ تولیدِ گزارش: " + $P{generatedAt}]]></textFieldExpression>
            </textField>
        </band>
    </pageHeader>

    <columnHeader>
        <band height="24">
            <rectangle>
                <reportElement x="0" y="0" width="535" height="24" backcolor="#DDDDDD" mode="Opaque"/>
            </rectangle>
            <staticText><reportElement style="Header" x="0" y="0" width="70" height="24"/><textElement textAlignment="Center" verticalAlignment="Middle"/><text><![CDATA[کد]]></text></staticText>
            <staticText><reportElement style="Header" x="70" y="0" width="220" height="24"/><textElement textAlignment="Center" verticalAlignment="Middle"/><text><![CDATA[نام]]></text></staticText>
            <staticText><reportElement style="Header" x="290" y="0" width="80" height="24"/><textElement textAlignment="Center" verticalAlignment="Middle"/><text><![CDATA[دسته]]></text></staticText>
            <staticText><reportElement style="Header" x="370" y="0" width="85" height="24"/><textElement textAlignment="Center" verticalAlignment="Middle"/><text><![CDATA[دوره‌یِ جاری]]></text></staticText>
            <staticText><reportElement style="Header" x="455" y="0" width="80" height="24"/><textElement textAlignment="Center" verticalAlignment="Middle"/><text><![CDATA[سالِ قبل]]></text></staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="18">
            <textField><reportElement x="0" y="0" width="70" height="18"/><textElement textAlignment="Center" verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{account_code}]]></textFieldExpression></textField>
            <textField>
                <reportElement x="70" y="0" width="220" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><paragraph rightIndent="4"/></textElement>
                <textFieldExpression><![CDATA[$F{account_name}]]></textFieldExpression>
            </textField>
            <textField><reportElement x="290" y="0" width="80" height="18"/><textElement textAlignment="Center" verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{category_label}]]></textFieldExpression></textField>
            <textField><reportElement x="370" y="0" width="85" height="18"/><textElement textAlignment="Center" verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{current_amount_display}]]></textFieldExpression></textField>
            <textField><reportElement x="455" y="0" width="80" height="18"/><textElement textAlignment="Center" verticalAlignment="Middle"/><textFieldExpression><![CDATA[$F{previous_amount_display}]]></textFieldExpression></textField>
        </band>
    </detail>

    <pageFooter>
        <band height="18">
            <textField>
                <reportElement style="Footer" x="0" y="0" width="535" height="18"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA["صفحه‌یِ " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="34">
            <line>
                <reportElement x="0" y="0" width="535" height="1"/>
            </line>
            <rectangle>
                <reportElement x="0" y="6" width="535" height="24" backcolor="#EFEFEF" mode="Opaque"/>
            </rectangle>
            <textField><reportElement style="TotalsLabel" x="290" y="6" width="80" height="24"/><textElement textAlignment="Center" verticalAlignment="Middle"/><textFieldExpression><![CDATA[$P{netIncomeLabel}]]></textFieldExpression></textField>
            <textField><reportElement style="TotalsLabel" x="370" y="6" width="85" height="24"/><textElement textAlignment="Center" verticalAlignment="Middle"/><textFieldExpression><![CDATA[$P{netIncomeDisplay}]]></textFieldExpression></textField>
        </band>
    </summary>

</jasperReport>

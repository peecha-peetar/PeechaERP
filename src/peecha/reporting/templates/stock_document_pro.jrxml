              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="stock_document_pro" pageWidth="595" pageHeight="842"
              columnWidth="539" leftMargin="28" rightMargin="28" topMargin="20" bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail">
    <style name="Default" isDefault="true" fontName="Vazirmatn" fontSize="8"/>
    <style name="Title" fontName="Vazirmatn" fontSize="15" isBold="true"/>

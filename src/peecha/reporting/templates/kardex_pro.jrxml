            <staticText><reportElement style="Header" x="111" y="0" width="60" height="22" forecolor="#FFFFFF"/><textElement textAlignment="Center" verticalAlignment="Middle"><paragraph rightIndent="2" leftIndent="2"/></textElement><text><![CDATA[قیمت فروش]]></text></staticText>
            <staticText><reportElement style="Header" x="66" y="0" width="45" height="22" forecolor="#FFFFFF"/><textElement textAlignment="Center" verticalAlignment="Middle"><paragraph rightIndent="2" leftIndent="2"/></textElement><text><![CDATA[مانده]]></text></staticText>

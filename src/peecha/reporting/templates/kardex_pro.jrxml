            <staticText><reportElement style="Header" x="239" y="0" width="68" height="22" forecolor="#FFFFFF"/><textElement textAlignment="Center" verticalAlignment="Middle"><paragraph rightIndent="2" leftIndent="2"/></textElement><text><![CDATA[بهای کل ورود]]></text></staticText>

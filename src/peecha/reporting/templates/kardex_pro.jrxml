            <line><reportElement x="0" y="17" width="802" height="1" forecolor="#C9D3E0"/></line>
            <textField textAdjust="ScaleFont"><reportElement style="Cell" x="732" y="0" width="70" height="17"/><textElement textAlignment="Center" verticalAlignment="Middle"><paragraph rightIndent="3" leftIndent="3"/></textElement><textFieldExpression><![CDATA[$F{movement_date_display}]]></textFieldExpression></textField>

            <staticText><reportElement style="Header" x="372" y="0" width="45" height="22" forecolor="#FFFFFF"/><textElement textAlignment="Center" verticalAlignment="Middle"><paragraph rightIndent="2" leftIndent="2"/></textElement><text><![CDATA[خروج]]></text></staticText>

    <field name="running_balance_display" class="java.lang.String">
        <property name="net.sf.jasperreports.json.field.expression" value="running_balance_display"/>
        <fieldDescription><![CDATA[مانده]]></fieldDescription>
    </field>
    <field name="running_value_balance_display" class="java.lang.String">
        <property name="net.sf.jasperreports.json.field.expression" value="running_value_balance_display"/>
        <fieldDescription><![CDATA[ماندهٔ ریالی]]></fieldDescription>
    </field>
    <pageHeader>
        <band height="96">
            <rectangle radius="4"><reportElement x="0" y="0" width="802" height="50" mode="Opaque" backcolor="#1F3A5F" forecolor="#1F3A5F"></reportElement><graphicElement><pen lineWidth="0" lineColor="#1F3A5F"/></graphicElement></rectangle>
            <image scaleImage="RetainShape" hAlign="Center" vAlign="Middle" onErrorType="Blank"><reportElement x="740" y="5" width="56" height="40"><printWhenExpression><![CDATA[$P{companyLogoPath} != null && !$P{companyLogoPath}.isEmpty() && "RIGHT".equals($P{companyLogoPosition})]]></printWhenExpression></reportElement><imageExpression><![CDATA[$P{companyLogoPath}]]></imageExpression></image>
            <image scaleImage="RetainShape" hAlign="Center" vAlign="Middle" onErrorType="Blank"><reportElement x="6" y="5" width="56" height="40"><printWhenExpression><![CDATA[$P{companyLogoPath} != null && !$P{companyLogoPath}.isEmpty() && "LEFT".equals($P{companyLogoPosition})]]></printWhenExpression></reportElement><imageExpression><![CDATA[$P{companyLogoPath}]]></imageExpression></image>
            <textField><reportElement style="Title" x="70" y="4" width="662" height="24" forecolor="#FFFFFF"/><textElement textAlignment="Center" verticalAlignment="Middle"><paragraph rightIndent="4" leftIndent="4"/></textElement><textFieldExpression><![CDATA["کاردکس کالا"]]></textFieldExpression></textField>
            <textField><reportElement style="TitleMeta" x="70" y="28" width="662" height="18" forecolor="#D6E2F2"/><textElement textAlignment="Center" verticalAlignment="Middle"><paragraph rightIndent="4" leftIndent="4"/></textElement><textFieldExpression><![CDATA[$P{companyName}]]></textFieldExpression></textField>
            <rectangle radius="4"><reportElement x="0" y="58" width="802" height="30" mode="Opaque" backcolor="#E8EEF6" forecolor="#E8EEF6"></reportElement><graphicElement><pen lineWidth="0" lineColor="#E8EEF6"/></graphicElement></rectangle>
            <staticText><reportElement style="MetaLabel" x="535" y="59" width="267" height="13"><printWhenExpression><![CDATA[$P{itemName} != null && !$P{itemName}.isEmpty()]]></printWhenExpression></reportElement><textElement textAlignment="Right" verticalAlignment="Middle"><paragraph rightIndent="4" leftIndent="4"/></textElement><text><![CDATA[کالا]]></text></staticText>
            <textField textAdjust="ScaleFont"><reportElement style="MetaValue" x="535" y="72" width="267" height="15"><printWhenExpression><![CDATA[$P{itemName} != null && !$P{itemName}.isEmpty()]]></printWhenExpression></reportElement><textElement textAlignment="Right" verticalAlignment="Middle"><paragraph rightIndent="4" leftIndent="4"/></textElement><textFieldExpression><![CDATA[$P{itemName}]]></textFieldExpression></textField>
            <staticText><reportElement style="MetaLabel" x="268" y="59" width="267" height="13"><printWhenExpression><![CDATA[$P{warehouseName} != null && !$P{warehouseName}.isEmpty()]]></printWhenExpression></reportElement><textElement textAlignment="Right" verticalAlignment="Middle"><paragraph rightIndent="4" leftIndent="4"/></textElement><text><![CDATA[انبار]]></text></staticText>
            <textField textAdjust="ScaleFont"><reportElement style="MetaValue" x="268" y="72" width="267" height="15"><printWhenExpression><![CDATA[$P{warehouseName} != null && !$P{warehouseName}.isEmpty()]]></printWhenExpression></reportElement><textElement textAlignment="Right" verticalAlignment="Middle"><paragraph rightIndent="4" leftIndent="4"/></textElement><textFieldExpression><![CDATA[$P{warehouseName}]]></textFieldExpression></textField>
            <staticText><reportElement style="MetaLabel" x="1" y="59" width="267" height="13"><printWhenExpression><![CDATA[$P{dateRangeLabel} != null && !$P{dateRangeLabel}.isEmpty()]]></printWhenExpression></reportElement><textElement textAlignment="Right" verticalAlignment="Middle"><paragraph rightIndent="4" leftIndent="4"/></textElement><text><![CDATA[بازهٔ گزارش]]></text></staticText>
            <textField textAdjust="ScaleFont"><reportElement style="MetaValue" x="1" y="72" width="267" height="15"><printWhenExpression><![CDATA[$P{dateRangeLabel} != null && !$P{dateRangeLabel}.isEmpty()]]></printWhenExpression></reportElement><textElement textAlignment="Right" verticalAlignment="Middle"><paragraph rightIndent="4" leftIndent="4"/></textElement><textFieldExpression><![CDATA[$P{dateRangeLabel}]]></textFieldExpression></textField>
        </band>
    </pageHeader>
    <columnHeader>
        <band height="22">

            <staticText><reportElement style="Header" x="732" y="0" width="70" height="22" forecolor="#FFFFFF"/><textElement textAlignment="Center" verticalAlignment="Middle"><paragraph rightIndent="2" leftIndent="2"/></textElement><text><![CDATA[تاریخ]]></text></staticText>
            <staticText><reportElement style="Header" x="667" y="0" width="65" height="22" forecolor="#FFFFFF"/><textElement textAlignment="Center" verticalAlignment="Middle"><paragraph rightIndent="2" leftIndent="2"/></textElement><text><![CDATA[نوع سند]]></text></staticText>
            <staticText><reportElement style="Header" x="622" y="0" width="45" height="22" forecolor="#FFFFFF"/><textElement textAlignment="Center" verticalAlignment="Middle"><paragraph rightIndent="2" leftIndent="2"/></textElement><text><![CDATA[شماره]]></text></staticText>

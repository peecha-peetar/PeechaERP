<?xml version="1.0" encoding="UTF-8"?>
<!-- R320: طرح حرفه‌ای (راست‌به‌چپ) — ساخته‌شده با tools/report_designs/build_pro_templates.py از income_statement.jrxml؛
     پارامترها و فیلدها همان قالب پایه است. -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="income_statement_pro" pageWidth="595" pageHeight="842"
              columnWidth="539" leftMargin="28" rightMargin="28" topMargin="20" bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail">
    <style name="Default" isDefault="true" fontName="Vazirmatn" fontSize="8"/>
    <style name="Title" fontName="Vazirmatn" fontSize="15" isBold="true"/>
    <style name="TitleMeta" fontName="Vazirmatn" fontSize="8"/>
    <style name="BoxTitle" fontName="Vazirmatn" fontSize="8" isBold="true" forecolor="#1F3A5F"/>
    <style name="BoxStrong" fontName="Vazirmatn" fontSize="9" isBold="true"/>
    <style name="BoxText" fontName="Vazirmatn" fontSize="7.5"/>
    <style name="MetaLabel" fontName="Vazirmatn" fontSize="7" forecolor="#5A6B82"/>
    <style name="MetaValue" fontName="Vazirmatn" fontSize="9" isBold="true"/>
    <style name="Header" fontName="Vazirmatn" fontSize="8" isBold="true"/>
    <style name="Cell" fontName="Vazirmatn" fontSize="8"/>
    <style name="TotalLabel" fontName="Vazirmatn" fontSize="8.5" isBold="true" forecolor="#1F3A5F"/>
    <style name="TotalValue" fontName="Vazirmatn" fontSize="8.5" isBold="true"/>
    <style name="GrandLabel" fontName="Vazirmatn" fontSize="10.5" isBold="true"/>
    <style name="GrandValue" fontName="Vazirmatn" fontSize="11" isBold="true"/>
    <style name="Note" fontName="Vazirmatn" fontSize="8"/>
    <style name="Footer" fontName="Vazirmatn" fontSize="7" forecolor="#5A6B82"/>
    <parameter name="companyName" class="java.lang.String">

        <parameterDescription><![CDATA[نام شرکت]]></parameterDescription>

    </parameter>
    <parameter name="dateRangeLabel" class="java.lang.String">
        <parameterDescription><![CDATA[بازهٔ تاریخ]]></parameterDescription>
    </parameter>
    <parameter name="generatedAt" class="java.lang.String">
        <parameterDescription><![CDATA[تاریخ تولید گزارش]]></parameterDescription>
    </parameter>
    <parameter name="netIncomeLabel" class="java.lang.String">
        <parameterDescription><![CDATA[برچسب سود خالص]]></parameterDescription>
    </parameter>
    <parameter name="netIncomeDisplay" class="java.lang.String">
        <parameterDescription><![CDATA[سود خالص]]></parameterDescription>
    </parameter>
    <parameter name="companyLogoPath" class="java.lang.String">
        <defaultValueExpression><![CDATA[""]]></defaultValueExpression>
    </parameter>
    <parameter name="companyLogoPosition" class="java.lang.String">
        <defaultValueExpression><![CDATA["NONE"]]></defaultValueExpression>
    </parameter>
    <field name="account_code" class="java.lang.String">

        <property name="net.sf.jasperreports.json.field.expression" value="account_code"/>

        <fieldDescription><![CDATA[کد حساب]]></fieldDescription>

    </field>
    <field name="account_name" class="java.lang.String">
        <property name="net.sf.jasperreports.json.field.expression" value="account_name"/>
        <fieldDescription><![CDATA[نام حساب]]></fieldDescription>
    </field>
    <field name="category_label" class="java.lang.String">
        <property name="net.sf.jasperreports.json.field.expression" value="category_label"/>
        <fieldDescription><![CDATA[دسته]]></fieldDescription>
    </field>
    <field name="current_amount_display" class="java.lang.String">
        <property name="net.sf.jasperreports.json.field.expression" value="current_amount_display"/>
        <fieldDescription><![CDATA[مبلغ دورهٔ جاری]]></fieldDescription>
    </field>
    <field name="previous_amount_display" class="java.lang.String">
        <property name="net.sf.jasperreports.json.field.expression" value="previous_amount_display"/>
        <fieldDescription><![CDATA[مبلغ دورهٔ قبل]]></fieldDescription>
    </field>
    <pageHeader>
        <band height="96">
            <rectangle radius="4"><reportElement x="0" y="0" width="539" height="50" mode="Opaque" backcolor="#1F3A5F" forecolor="#1F3A5F"></reportElement><graphicElement><pen lineWidth="0" lineColor="#1F3A5F"/></graphicElement></rectangle>
            <image scaleImage="RetainShape" hAlign="Center" vAlign="Middle" onErrorType="Blank"><reportElement x="477" y="5" width="56" height="40"><printWhenExpression><![CDATA[$P{companyLogoPath} != null && !$P{companyLogoPath}.isEmpty() && "RIGHT".equals($P{companyLogoPosition})]]></printWhenExpression></reportElement><imageExpression><![CDATA[$P{companyLogoPath}]]></imageExpression></image>
            <image scaleImage="RetainShape" hAlign="Center" vAlign="Middle" onErrorType="Blank"><reportElement x="6" y="5" width="56" height="40"><printWhenExpression><![CDATA[$P{companyLogoPath} != null && !$P{companyLogoPath}.isEmpty() && "LEFT".equals($P{companyLogoPosition})]]></printWhenExpression></reportElement><imageExpression><![CDATA[$P{companyLogoPath}]]></imageExpression></image>
            <textField><reportElement style="Title" x="70" y="4" width="399" height="24" forecolor="#FFFFFF"/><textElement textAlignment="Center" verticalAlignment="Middle"><paragraph rightIndent="4" leftIndent="4"/></textElement><textFieldExpression><![CDATA["صورت سود و زیان"]]></textFieldExpression></textField>
            <textField><reportElement style="TitleMeta" x="70" y="28" width="399" height="18" forecolor="#D6E2F2"/><textElement textAlignment="Center" verticalAlignment="Middle"><paragraph rightIndent="4" leftIndent="4"/></textElement><textFieldExpression><![CDATA[$P{companyName}]]></textFieldExpression></textField>
            <rectangle radius="4"><reportElement x="0" y="58" width="539" height="30" mode="Opaque" backcolor="#E8EEF6" forecolor="#E8EEF6"></reportElement><graphicElement><pen lineWidth="0" lineColor="#E8EEF6"/></graphicElement></rectangle>
            <staticText><reportElement style="MetaLabel" x="270" y="59" width="269" height="13"><printWhenExpression><![CDATA[$P{dateRangeLabel} != null && !$P{dateRangeLabel}.isEmpty()]]></printWhenExpression></reportElement><textElement textAlignment="Right" verticalAlignment="Middle"><paragraph rightIndent="4" leftIndent="4"/></textElement><text><![CDATA[بازهٔ گزارش]]></text></staticText>
            <textField textAdjust="ScaleFont"><reportElement style="MetaValue" x="270" y="72" width="269" height="15"><printWhenExpression><![CDATA[$P{dateRangeLabel} != null && !$P{dateRangeLabel}.isEmpty()]]></printWhenExpression></reportElement><textElement textAlignment="Right" verticalAlignment="Middle"><paragraph rightIndent="4" leftIndent="4"/></textElement><textFieldExpression><![CDATA[$P{dateRangeLabel}]]></textFieldExpression></textField>
        </band>
    </pageHeader>
    <columnHeader>
        <band height="22">
            <rectangle radius="0"><reportElement x="0" y="0" width="539" height="22" mode="Opaque" backcolor="#1F3A5F" forecolor="#1F3A5F"></reportElement><graphicElement><pen lineWidth="0" lineColor="#1F3A5F"/></graphicElement></rectangle>
            <staticText><reportElement style="Header" x="469" y="0" width="70" height="22" forecolor="#FFFFFF"/><textElement textAlignment="Center" verticalAlignment="Middle"><paragraph rightIndent="2" leftIndent="2"/></textElement><text><![CDATA[کد]]></text></staticText>
            <staticText><reportElement style="Header" x="269" y="0" width="200" height="22" forecolor="#FFFFFF"/><textElement textAlignment="Center" verticalAlignment="Middle"><paragraph rightIndent="2" leftIndent="2"/></textElement><text><![CDATA[نام حساب]]></text></staticText>
            <staticText><reportElement style="Header" x="189" y="0" width="80" height="22" forecolor="#FFFFFF"/><textElement textAlignment="Center" verticalAlignment="Middle"><paragraph rightIndent="2" leftIndent="2"/></textElement><text><![CDATA[دسته]]></text></staticText>
            <staticText><reportElement style="Header" x="94" y="0" width="95" height="22" forecolor="#FFFFFF"/><textElement textAlignment="Center" verticalAlignment="Middle"><paragraph rightIndent="2" leftIndent="2"/></textElement><text><![CDATA[دورهٔ جاری]]></text></staticText>
            <staticText><reportElement style="Header" x="0" y="0" width="94" height="22" forecolor="#FFFFFF"/><textElement textAlignment="Center" verticalAlignment="Middle"><paragraph rightIndent="2" leftIndent="2"/></textElement><text><![CDATA[سال قبل]]></text></staticText>
        </band>
    </columnHeader>
    <detail>
        <band height="18">
            <rectangle radius="0"><reportElement x="0" y="0" width="539" height="18" mode="Opaque" backcolor="#F6F8FB" forecolor="#F6F8FB"><printWhenExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></printWhenExpression></reportElement><graphicElement><pen lineWidth="0" lineColor="#F6F8FB"/></graphicElement></rectangle>
            <line><reportElement x="0" y="17" width="539" height="1" forecolor="#C9D3E0"/></line>
            <textField textAdjust="ScaleFont"><reportElement style="Cell" x="469" y="0" width="70" height="17"/><textElement textAlignment="Center" verticalAlignment="Middle"><paragraph rightIndent="3" leftIndent="3"/></textElement><textFieldExpression><![CDATA[$F{account_code}]]></textFieldExpression></textField>
            <textField textAdjust="ScaleFont"><reportElement style="Cell" x="269" y="0" width="200" height="17"/><textElement textAlignment="Right" verticalAlignment="Middle"><paragraph rightIndent="3" leftIndent="3"/></textElement><textFieldExpression><![CDATA[$F{account_name}]]></textFieldExpression></textField>
            <textField textAdjust="ScaleFont"><reportElement style="Cell" x="189" y="0" width="80" height="17"/><textElement textAlignment="Right" verticalAlignment="Middle"><paragraph rightIndent="3" leftIndent="3"/></textElement><textFieldExpression><![CDATA[$F{category_label}]]></textFieldExpression></textField>
            <textField textAdjust="ScaleFont"><reportElement style="Cell" x="94" y="0" width="95" height="17"/><textElement textAlignment="Center" verticalAlignment="Middle"><paragraph rightIndent="3" leftIndent="3"/></textElement><textFieldExpression><![CDATA[$F{current_amount_display}]]></textFieldExpression></textField>
            <textField textAdjust="ScaleFont"><reportElement style="Cell" x="0" y="0" width="94" height="17"/><textElement textAlignment="Center" verticalAlignment="Middle"><paragraph rightIndent="3" leftIndent="3"/></textElement><textFieldExpression><![CDATA[$F{previous_amount_display}]]></textFieldExpression></textField>
        </band>
    </detail>
    <pageFooter>
        <band height="20">
            <line><reportElement x="0" y="2" width="539" height="1" forecolor="#1F3A5F"/></line>
            <textField evaluationTime="Master"><reportElement style="Footer" x="379" y="5" width="160" height="14"/><textElement textAlignment="Right" verticalAlignment="Middle"><paragraph rightIndent="1" leftIndent="1"/></textElement><textFieldExpression><![CDATA["صفحهٔ " + String.valueOf($V{MASTER_CURRENT_PAGE}).replace("0","۰").replace("1","۱").replace("2","۲").replace("3","۳").replace("4","۴").replace("5","۵").replace("6","۶").replace("7","۷").replace("8","۸").replace("9","۹") + " از " + String.valueOf($V{MASTER_TOTAL_PAGES}).replace("0","۰").replace("1","۱").replace("2","۲").replace("3","۳").replace("4","۴").replace("5","۵").replace("6","۶").replace("7","۷").replace("8","۸").replace("9","۹")]]></textFieldExpression></textField>
            <textField><reportElement style="Footer" x="0" y="5" width="369" height="14"><printWhenExpression><![CDATA[$P{generatedAt} != null && !$P{generatedAt}.isEmpty()]]></printWhenExpression></reportElement><textElement textAlignment="Left" verticalAlignment="Middle"><paragraph rightIndent="4" leftIndent="4"/></textElement><textFieldExpression><![CDATA["تاریخ چاپ: " + $P{generatedAt}]]></textFieldExpression></textField>
        </band>
    </pageFooter>
    <summary>
        <band height="46">
            <rectangle radius="4"><reportElement x="0" y="8" width="230" height="26" mode="Opaque" backcolor="#1F3A5F" forecolor="#1F3A5F"></reportElement><graphicElement><pen lineWidth="0" lineColor="#1F3A5F"/></graphicElement></rectangle>
            <textField><reportElement style="GrandValue" x="0" y="8" width="120" height="26" forecolor="#FFFFFF"/><textElement textAlignment="Left" verticalAlignment="Middle"><paragraph rightIndent="4" leftIndent="4"/></textElement><textFieldExpression><![CDATA[$P{netIncomeDisplay}]]></textFieldExpression></textField>
            <textField><reportElement style="GrandLabel" x="120" y="8" width="110" height="26" forecolor="#FFFFFF"/><textElement textAlignment="Right" verticalAlignment="Middle"><paragraph rightIndent="4" leftIndent="4"/></textElement><textFieldExpression><![CDATA[$P{netIncomeLabel}]]></textFieldExpression></textField>
        </band>
    </summary>
</jasperReport>

#:import shape peecha.ui.rtl.shape
#:import theme peecha.ui.theme
#:import dp kivy.metrics.dp

# استایل مرکزی پیچا — معادل یک فایل CSS برای Kivy: به‌جای تکرار font_name/
# halign روی تک‌تک ویجت‌ها در هر صفحه (که باعث شد یک‌بار یادمان برود و یک
# صفحه فونتش نصفه‌نیمه بماند)، اینجا یک‌بار تعریف می‌شود و همه‌ی صفحات از
# همین کلاس‌ها استفاده می‌کنند. این فایل باید قبل از هر kv دیگری Builder شود
# (در src/peecha/ui/app.py، قبل از import صفحات).


# نکته‌ی مهم: خودِ MDLabel به‌صورت پیش‌فرض (در label.kv خودِ KivyMD)
# text_size را روی (self.width, None) می‌گذارد تا متن چندخطی wrap شود.
# چون shape() کل رشته را یک‌بار برای نمایش تک‌خطیِ RTL بازچینی می‌کند، اگر
# Label بعداً همین رشته‌ی بازچینی‌شده را با منطق wrap چپ‌به‌راستِ خودش به
# چند خط بشکند، نتیجه کاملاً درهم می‌شود (نه فقط زشت، غلط). راه‌حل، خاموش
# نگه‌داشتنِ wrap با max_lines=1 است، نه حذف text_size (که ارث‌بری از
# MDLabel دوباره آن را ست می‌کند). به‌جای شکستن خط، متنِ زیادی با «...»
# از سمت چپ (انتهای بصریِ متنِ راست‌چین) کوتاه می‌شود.
<PLabel@MDLabel>:
    font_name: app.font_name
    halign: "right"
    max_lines: 1
    shorten: True
    shorten_from: "left"

<PTitleLabel@MDLabel>:
    font_name: app.font_name
    font_style: "H5"
    halign: "right"
    max_lines: 1
    shorten: True
    shorten_from: "left"
    size_hint_y: None
    height: self.texture_size[1]

<PHintLabel@MDLabel>:
    font_name: app.font_name
    halign: "right"
    theme_text_color: "Hint"
    max_lines: 1
    shorten: True
    shorten_from: "left"
    size_hint_y: None
    height: self.texture_size[1] if self.text else "0dp"

# PTextField خودش یک کلاس پایتونی است (src/peecha/ui/widgets.py)، نه یک
# دینامیک‌کلاسِ خالص KV، چون راست‌چین‌کردن لیبل شناور hint/helper نیاز به
# کد پایتون دارد (توضیح در همان فایل). اینجا فقط ظاهر ویجت خودش را تنظیم می‌کنیم.
<PTextField>:
    font_name: app.font_name
    font_name_hint_text: app.font_name
    font_name_helper_text: app.font_name
    halign: "right"
    size_hint_y: None
    height: "48dp"
    # همه‌ی فیلدهای برنامه تک‌خطی‌اند: multiline:False یعنی Enter به‌جای
    # افزودن خط جدید، رویداد on_text_validate را شلیک می‌کند (برای ثبتِ
    # فرم با کیبورد)؛ write_tab:False یعنی Tab کاراکتر تب وارد نمی‌کند،
    # به‌جایش فوکوس را طبق focus_next/focus_previous جابه‌جا می‌کند.
    multiline: False
    write_tab: False
    mode: "fill"
    radius: [12, 12, 0, 0]
    fill_color_normal: theme.HOVER
    fill_color_focus: theme.HOVER
    line_color_normal: theme.BORDER
    line_color_focus: theme.ACCENT
    hint_text_color_normal: theme.TEXT_SECONDARY
    hint_text_color_focus: theme.ACCENT
    text_color_normal: theme.TEXT_PRIMARY
    text_color_focus: theme.TEXT_PRIMARY

# نکته: عمداً radius روی این دو کلاس ست نمی‌شود. MDRaisedButton/MDFlatButton
# خودشان property عمومیِ radius ندارند (فقط یک _radius خصوصیِ عددی که از
# ارتفاع دکمه محاسبه می‌شود، طبق kivymd/uix/button/button.py)؛ ست‌کردن یک
# radius دلخواه روی این‌ها یک property موقتیِ Kivy می‌سازد که با فرمول
# سایه‌ی داخلیِ خودِ KivyMD (CommonElevationBehavior، که همان اسم را چک
# می‌کند) تداخل می‌کند و با دکمه‌ی ارتفاع-صفر (مثل bootstrap_button مخفی)
# کرش می‌دهد (`ValueError: border_radius must have 4, got 0`، با تست مستقیم
# پیدا شد). ارتفاع/۲ همین الان دکمه‌ها را کپسولی نشان می‌دهد، نیازی نیست.
# کلاسِ پایتونیِ واقعی‌اند (نه دینامیک‌کلاسِ خالص KV) چون MDRaisedButton/
# MDFlatButton خودشان FocusBehavior ندارند (با Tab قابل‌رسیدن نبودند و
# focus_next یک فیلدِ دیگر نمی‌توانست به آن‌ها وصل شود — تست مستقیم تایید
# کرد)؛ PRaisedButton/PFlatButton این را هم اضافه می‌کنند.
# طبق مدرن‌سازیِ ظاهر (نسخه‌ی دوم): دکمه‌ها به‌جای مستطیلِ کمی‌گردشده،
# کاملاً قرصی/pill هستند (rounded_button خودِ KivyMD — radius = نصفِ
# ارتفاع) — یک تغییرِ ظاهریِ فوری و غیرقابل‌چشم‌پوشی، برخلافِ ظرافت‌های
# فازِ قبل. حلقه‌ی فوکوس هم به همین شعاع تطبیق داده شد تا با شکلِ خودِ
# دکمه یکی باشد.
<PRaisedButton>:
    font_name: app.font_name
    elevation: 0
    rounded_button: True
    md_bg_color: theme.ACCENT
    canvas.after:
        Color:
            rgba: theme.PRIMARY if self.focus else (0, 0, 0, 0)
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, self.height / 2)
            width: 1.5

<PFlatButton>:
    font_name: app.font_name
    rounded_button: True
    canvas.after:
        Color:
            rgba: theme.ACCENT if self.focus else (0, 0, 0, 0)
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, self.height / 2)
            width: 1.5

# فیلدِ انتخابی (select) — برای دکمه‌هایی که یک منوی کشویی باز می‌کنند
# (ماهیت/دسته/نوع حساب/والد و...)؛ قبلاً از PFlatButton استفاده می‌شد که
# شبیه یک لینک ساده بود، نه یک فیلد فرم. ظاهرش هم‌خانواده‌ی PTextField
# (fill + radius) است تا با بقیه‌ی فرم یک‌دست باشد. کلاسِ پایتونیِ واقعی
# است به همان دلیلِ PTabButton (کیبورد).
<PSelectField>:
    orientation: "horizontal"
    size_hint_y: None
    height: "48dp"
    padding: ["14dp", "0dp"]
    spacing: "6dp"
    radius: [12, 12, 12, 12]
    md_bg_color: theme.HOVER
    canvas.after:
        Color:
            rgba: theme.ACCENT if root.focus else (0, 0, 0, 0)
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, 12)
            width: 1.5

    PLabel:
        text: root.text
        valign: "middle"

    MDIcon:
        icon: "chevron-down"
        theme_text_color: "Custom"
        text_color: theme.TEXT_SECONDARY
        size_hint_x: None
        width: self.texture_size[0]

# آیتمِ منوی کشویی — راست‌چین (توضیحِ کامل در widgets.py، PDropdownItem):
# MDDropdownTextItem خودِ KivyMD همیشه چپ‌چین است و هیچ property عمومی
# برای override کردنش ندارد؛ PLabel همان استایلِ راست‌چین/کوتاه‌سازیِ
# بقیه‌ی برنامه را می‌آورد.
<PDropdownItem>:
    size_hint_y: None
    height: "48dp"
    padding: ["12dp", "0dp"]

    PLabel:
        text: root.text
        valign: "middle"
        theme_text_color: "Custom" if root.text_color else "Primary"
        text_color: root.text_color if root.text_color else theme.TEXT_PRIMARY

<PLabelListRow>:
    size_hint_y: None
    height: "44dp"
    padding: ["12dp", "0dp"]
    radius: [10, 10, 10, 10]
    md_bg_color: theme.HOVER if root.zebra else (0, 0, 0, 0)

    PLabel:
        text: root.text
        valign: "middle"

<PEmptyState>:
    orientation: "vertical"
    size_hint_y: None
    height: "180dp"
    spacing: "10dp"
    padding: ["0dp", "28dp"]

    MDIcon:
        icon: root.icon
        theme_text_color: "Custom"
        text_color: theme.TEXT_DISABLED
        font_size: "44sp"
        halign: "center"
        size_hint_y: None
        height: self.texture_size[1]

    PLabel:
        text: root.text
        halign: "center"
        theme_text_color: "Custom"
        text_color: theme.TEXT_SECONDARY
        size_hint_y: None
        height: self.texture_size[1]

<PBadge>:
    size_hint: None, None
    size: self.minimum_width, dp(24)
    padding: ["10dp", "0dp"]
    radius: [12, 12, 12, 12]
    md_bg_color: root.badge_color[0], root.badge_color[1], root.badge_color[2], 0.14

    PLabel:
        text: root.text
        theme_text_color: "Custom"
        text_color: root.badge_color
        font_style: "Caption"
        halign: "center"
        valign: "middle"
        adaptive_width: True

# نکته‌ی مهمِ RTL: در BoxLayout افقیِ Kivy، فرزندِ اول‌اعلام‌شده همیشه
# چپ‌ترین و آخری راست‌ترین می‌شود (تست مستقیم تایید کرد، Kivy خودش هیچ
# پرچمِ RTL برای BoxLayout ندارد). برای این‌که آیکون — که باید اول چیزی
# باشد که چشمِ خواننده‌ی راست‌به‌چپ می‌بیند — راست‌ترین بیفتد، باید در KV
# بعد از لیبل اعلام شود، نه قبلش.
# طبق مدرن‌سازیِ ظاهر (نسخه‌ی دوم): چون نوارِ کناری حالا تیره است (نه
# سفیدِ قبلی)، این دو ویجت (که فقط در نوارِ کناری استفاده می‌شوند — تنها
# مصرف‌کننده‌شان shell.py است) رنگ‌بندیِ روشن گرفتند: متنِ خاکستریِ روشن
# برای حالتِ عادی، و یک قرصِ رنگی (accent) با متنِ سفید برای آیتمِ انتخاب‌شده
# — به‌جای رنگِ آبیِ کم‌رنگِ قبلی که تفاوتش به‌سختی دیده می‌شد.
# دکمه‌ی ریبونِ میان‌برِ سریع — آیکون بالا/برچسب پایین، مثلِ ردیفِ آیکون‌های
# نرم‌افزارهای حسابداریِ کلاسیک (کالا/طرف حساب/فاکتور/...) اما با پالتِ تازه.
<PRibbonButton>:
    orientation: "vertical"
    size_hint: None, 1
    width: "76dp"
    padding: ["4dp", "8dp"]
    spacing: "4dp"
    radius: [12, 12, 12, 12]
    md_bg_color: theme.SELECTED if root.selected else (0, 0, 0, 0)

    MDIcon:
        icon: root.icon
        font_size: "22sp"
        theme_text_color: "Custom"
        text_color: theme.ACCENT if root.selected else theme.TEXT_SECONDARY
        halign: "center"
        valign: "middle"
        size_hint_y: None
        height: "26dp"

    PLabel:
        text: root.text
        font_style: "Caption"
        halign: "center"
        theme_text_color: "Custom"
        text_color: theme.ACCENT if root.selected else theme.TEXT_SECONDARY
        bold: root.selected
        valign: "top"
        size_hint_y: None
        height: self.texture_size[1]

<PNavItem>:
    orientation: "horizontal"
    size_hint_y: None
    height: "40dp" if root.sub else "44dp"
    padding: [("6dp" if root.collapsed else "12dp"), "0dp", ("6dp" if root.collapsed else ("30dp" if root.sub else "12dp")), "0dp"]
    spacing: "8dp"
    radius: [10, 10, 10, 10]
    md_bg_color: theme.ACCENT if root.selected else (0, 0, 0, 0)

    PLabel:
        text: root.text
        theme_text_color: "Custom"
        text_color: (1, 1, 1, 1) if root.selected else (1, 1, 1, 0.7)
        font_style: "Caption" if root.sub else "Body1"
        bold: root.selected
        valign: "middle"
        opacity: 0 if root.collapsed else 1
        size_hint_x: 0 if root.collapsed else 1

    MDIcon:
        icon: root.icon
        font_size: "18sp" if root.sub else "24sp"
        theme_text_color: "Custom"
        text_color: (1, 1, 1, 1) if root.selected else (1, 1, 1, 0.55)
        size_hint_x: None
        width: self.texture_size[0]

<PNavGroupLabel>:
    orientation: "horizontal"
    size_hint_y: None
    height: "36dp"
    padding: [("6dp" if root.collapsed else "12dp"), "0dp"]
    spacing: "8dp"

    MDIcon:
        # شِوروُنِ جمع/باز — طبق قراردادِ چیدمانِ افقیِ RTL (اول‌اعلام‌شده =
        # سمتِ چپ)، این اولین فرزند است تا کنارِ لبه‌ی چپِ ردیف بنشیند.
        icon: "chevron-down" if root.expanded else "chevron-left"
        theme_text_color: "Custom"
        text_color: 1, 1, 1, 0.45
        size_hint_x: None
        width: 0 if root.collapsed else self.texture_size[0]
        opacity: 0 if root.collapsed else 1

    PLabel:
        text: root.text
        theme_text_color: "Custom"
        text_color: 1, 1, 1, 0.45
        font_style: "Caption"
        valign: "middle"
        opacity: 0 if root.collapsed else 1
        size_hint_x: 0 if root.collapsed else 1

    MDIcon:
        icon: root.icon
        theme_text_color: "Custom"
        text_color: 1, 1, 1, 0.55
        size_hint_x: None
        width: self.texture_size[0]

<PCard>:
    orientation: "vertical"
    padding: "18dp"
    spacing: "12dp"
    radius: [16, 16, 16, 16]
    md_bg_color: theme.SURFACE

<PStatCard>:
    orientation: "vertical"
    size_hint_y: None
    height: "156dp"
    padding: "18dp"
    spacing: "8dp"
    radius: [16, 16, 16, 16]
    md_bg_color: theme.SURFACE
    # نوارِ رنگیِ باریکِ بالای کارت — طبقِ بازطراحیِ مدرن، هر KPI رنگِ
    # آیکونِ خودش را به‌عنوانِ یک اکسنتِ ظریفِ بالای کارت هم تکرار می‌کند.
    canvas.after:
        Color:
            rgba: root.icon_bg_color
        RoundedRectangle:
            pos: self.x, self.y + self.height - dp(4)
            size: self.width, dp(4)
            radius: [16, 16, 0, 0]

    BoxLayout:
        size_hint_y: None
        height: "40dp"
        spacing: "8dp"

        PLabel:
            text: root.title
            font_style: "Caption"
            theme_text_color: "Custom"
            text_color: theme.TEXT_SECONDARY
            valign: "middle"

        MDBoxLayout:
            size_hint: None, None
            size: "40dp", "40dp"
            radius: [20, 20, 20, 20]
            md_bg_color: root.icon_bg_color

            MDIcon:
                icon: root.icon
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1
                halign: "center"
                valign: "middle"

    PLabel:
        text: root.value
        font_style: "H4"
        theme_text_color: "Custom"
        text_color: theme.TEXT_PRIMARY
        size_hint_y: None
        height: self.texture_size[1]

    PLabel:
        text: root.subtitle
        font_style: "Caption"
        theme_text_color: "Custom"
        text_color: theme.TEXT_SECONDARY
        size_hint_y: None
        height: self.texture_size[1]

    PLabel:
        text: root.trend_text
        font_style: "Caption"
        theme_text_color: "Custom"
        text_color: theme.SUCCESS if root.trend_positive else theme.DANGER
        size_hint_y: None
        height: self.texture_size[1]

#:import shape peecha.ui.rtl.shape
#:import theme peecha.ui.theme
#:import dp kivy.metrics.dp

# استایل مرکزی پیچا — معادل یک فایل CSS برای Kivy: به‌جای تکرار font_name/
# halign روی تک‌تک ویجت‌ها در هر صفحه (که باعث شد یک‌بار یادمان برود و یک
# صفحه فونتش نصفه‌نیمه بماند)، اینجا یک‌بار تعریف می‌شود و همه‌ی صفحات از
# همین کلاس‌ها استفاده می‌کنند. این فایل باید قبل از هر kv دیگری Builder شود
# (در src/peecha/ui/app.py، قبل از import صفحات).


# نکته‌ی مهم: خودِ MDLabel به‌صورت پیش‌فرض (در label.kv خودِ KivyMD)
# text_size را روی (self.width, None) می‌گذارد تا متن چندخطی wrap شود.
# چون shape() کل رشته را یک‌بار برای نمایش تک‌خطیِ RTL بازچینی می‌کند، اگر
# Label بعداً همین رشته‌ی بازچینی‌شده را با منطق wrap چپ‌به‌راستِ خودش به
# چند خط بشکند، نتیجه کاملاً درهم می‌شود (نه فقط زشت، غلط). راه‌حل، خاموش
# نگه‌داشتنِ wrap با max_lines=1 است، نه حذف text_size (که ارث‌بری از
# MDLabel دوباره آن را ست می‌کند). به‌جای شکستن خط، متنِ زیادی با «...»
# از سمت چپ (انتهای بصریِ متنِ راست‌چین) کوتاه می‌شود.
<PLabel@MDLabel>:
    font_name: app.font_name
    halign: "right"
    max_lines: 1
    shorten: True
    shorten_from: "left"

<PTitleLabel@MDLabel>:
    font_name: app.font_name
    font_style: "H5"
    halign: "right"
    max_lines: 1
    shorten: True
    shorten_from: "left"
    size_hint_y: None
    height: self.texture_size[1]

<PHintLabel@MDLabel>:
    font_name: app.font_name
    halign: "right"
    theme_text_color: "Hint"
    max_lines: 1
    shorten: True
    shorten_from: "left"
    size_hint_y: None
    height: self.texture_size[1] if self.text else "0dp"

# PTextField خودش یک کلاس پایتونی است (src/peecha/ui/widgets.py)، نه یک
# دینامیک‌کلاسِ خالص KV، چون راست‌چین‌کردن لیبل شناور hint/helper نیاز به
# کد پایتون دارد (توضیح در همان فایل). اینجا فقط ظاهر ویجت خودش را تنظیم می‌کنیم.
<PTextField>:
    font_name: app.font_name
    font_name_hint_text: app.font_name
    font_name_helper_text: app.font_name
    halign: "right"
    size_hint_y: None
    height: "48dp"
    mode: "fill"
    radius: [12, 12, 0, 0]
    fill_color_normal: theme.HOVER
    fill_color_focus: theme.HOVER
    line_color_normal: theme.BORDER
    line_color_focus: theme.ACCENT
    hint_text_color_normal: theme.TEXT_SECONDARY
    hint_text_color_focus: theme.ACCENT
    text_color_normal: theme.TEXT_PRIMARY
    text_color_focus: theme.TEXT_PRIMARY

# نکته: عمداً radius روی این دو کلاس ست نمی‌شود. MDRaisedButton/MDFlatButton
# خودشان property عمومیِ radius ندارند (فقط یک _radius خصوصیِ عددی که از
# ارتفاع دکمه محاسبه می‌شود، طبق kivymd/uix/button/button.py)؛ ست‌کردن یک
# radius دلخواه روی این‌ها یک property موقتیِ Kivy می‌سازد که با فرمول
# سایه‌ی داخلیِ خودِ KivyMD (CommonElevationBehavior، که همان اسم را چک
# می‌کند) تداخل می‌کند و با دکمه‌ی ارتفاع-صفر (مثل bootstrap_button مخفی)
# کرش می‌دهد (`ValueError: border_radius must have 4, got 0`، با تست مستقیم
# پیدا شد). ارتفاع/۲ همین الان دکمه‌ها را کپسولی نشان می‌دهد، نیازی نیست.
<PRaisedButton@MDRaisedButton>:
    font_name: app.font_name
    elevation: 0
    md_bg_color: theme.ACCENT

<PFlatButton@MDFlatButton>:
    font_name: app.font_name

# دکمه‌ی یک بخشِ نوارِ تبِ کپسولی (مثلاً «کدینگ حسابداری» / «صدور سند»)؛
# root.active رنگ پس‌زمینه/متن را کنترل می‌کند، خودِ کلیک با on_release
# در هر صفحه مدیریت می‌شود (چون مقصدِ ناوبری هرجا فرق می‌کند).
<PTabButton@ButtonBehavior+MDBoxLayout>:
    active: False
    text: ""
    size_hint: None, None
    size: self.minimum_width, dp(36)
    padding: ["18dp", "0dp"]
    radius: [18, 18, 18, 18]
    md_bg_color: theme.ACCENT if root.active else (0, 0, 0, 0)

    PLabel:
        text: root.text
        theme_text_color: "Custom"
        text_color: (1, 1, 1, 1) if root.active else theme.TEXT_SECONDARY
        halign: "center"
        valign: "middle"
        # adaptive_width نه size_hint_x/width دستی — توضیح کامل در dashboard.kv:
        # فرمول text_size خودِ MDLabel به adaptive_width وابسته است، پس همین یک
        # پرچم هم عرض را خودکار می‌کند هم از حلقه‌ی خودمرجعِ shorten جلوگیری می‌کند.
        adaptive_width: True

# فیلدِ انتخابی (select) — برای دکمه‌هایی که یک منوی کشویی باز می‌کنند
# (ماهیت/دسته/نوع حساب/والد و...)؛ قبلاً از PFlatButton استفاده می‌شد که
# شبیه یک لینک ساده بود، نه یک فیلد فرم. ظاهرش هم‌خانواده‌ی PTextField
# (fill + radius) است تا با بقیه‌ی فرم یک‌دست باشد.
<PSelectField@ButtonBehavior+MDBoxLayout>:
    text: ""
    orientation: "horizontal"
    size_hint_y: None
    height: "48dp"
    padding: ["14dp", "0dp"]
    spacing: "6dp"
    radius: [12, 12, 12, 12]
    md_bg_color: theme.HOVER

    PLabel:
        text: root.text
        valign: "middle"

    MDIcon:
        icon: "chevron-down"
        theme_text_color: "Custom"
        text_color: theme.TEXT_SECONDARY
        size_hint_x: None
        width: self.texture_size[0]

<PLabelListRow>:
    size_hint_y: None
    height: "44dp"
    padding: ["12dp", "0dp"]
    radius: [10, 10, 10, 10]
    md_bg_color: theme.HOVER if root.zebra else (0, 0, 0, 0)

    PLabel:
        text: root.text
        valign: "middle"

<PEmptyState>:
    orientation: "vertical"
    size_hint_y: None
    height: "180dp"
    spacing: "10dp"
    padding: ["0dp", "28dp"]

    MDIcon:
        icon: root.icon
        theme_text_color: "Custom"
        text_color: theme.TEXT_DISABLED
        font_size: "44sp"
        halign: "center"
        size_hint_y: None
        height: self.texture_size[1]

    PLabel:
        text: root.text
        halign: "center"
        theme_text_color: "Custom"
        text_color: theme.TEXT_SECONDARY
        size_hint_y: None
        height: self.texture_size[1]

<PNavItem>:
    orientation: "horizontal"
    size_hint_y: None
    height: "44dp"
    padding: ["12dp", "0dp"]
    spacing: "8dp"
    radius: [10, 10, 10, 10]
    md_bg_color: theme.SELECTED if root.selected else (0, 0, 0, 0)

    MDIcon:
        icon: root.icon
        theme_text_color: "Custom"
        text_color: theme.ACCENT if root.selected else theme.TEXT_SECONDARY

    PLabel:
        text: root.text
        theme_text_color: "Custom"
        text_color: theme.ACCENT if root.selected else theme.TEXT_PRIMARY
        valign: "middle"

<PCard>:
    orientation: "vertical"
    padding: "20dp"
    spacing: "12dp"
    radius: [20, 20, 20, 20]
    md_bg_color: theme.SURFACE

<PStatCard>:
    orientation: "vertical"
    size_hint_y: None
    height: "156dp"
    padding: "20dp"
    spacing: "8dp"
    radius: [20, 20, 20, 20]
    md_bg_color: theme.SURFACE

    BoxLayout:
        size_hint_y: None
        height: "40dp"
        spacing: "8dp"

        PLabel:
            text: root.title
            font_style: "Caption"
            theme_text_color: "Custom"
            text_color: theme.TEXT_SECONDARY
            valign: "middle"

        MDBoxLayout:
            size_hint: None, None
            size: "40dp", "40dp"
            radius: [20, 20, 20, 20]
            md_bg_color: root.icon_bg_color

            MDIcon:
                icon: root.icon
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1
                halign: "center"
                valign: "middle"

    PLabel:
        text: root.value
        font_style: "H4"
        theme_text_color: "Custom"
        text_color: theme.TEXT_PRIMARY
        size_hint_y: None
        height: self.texture_size[1]

    PLabel:
        text: root.subtitle
        font_style: "Caption"
        theme_text_color: "Custom"
        text_color: theme.TEXT_SECONDARY
        size_hint_y: None
        height: self.texture_size[1]

    PLabel:
        text: root.trend_text
        font_style: "Caption"
        theme_text_color: "Custom"
        text_color: theme.SUCCESS if root.trend_positive else theme.DANGER
        size_hint_y: None
        height: self.texture_size[1]

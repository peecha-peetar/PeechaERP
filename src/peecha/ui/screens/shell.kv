#:import shape peecha.ui.rtl.shape
#:import theme peecha.ui.theme

<ShellScreen>:
    name: "shell"
    md_bg_color: theme.BACKGROUND

    BoxLayout:
        orientation: "horizontal"

        # محتوا (چپ)
        BoxLayout:
            orientation: "vertical"

            # نوار بالا
            BoxLayout:
                size_hint_y: None
                height: "64dp"
                padding: ["20dp", "8dp"]
                spacing: "12dp"
                canvas.before:
                    Color:
                        rgba: theme.SURFACE
                    Rectangle:
                        pos: self.pos
                        size: self.size
                    Color:
                        rgba: theme.DIVIDER
                    Line:
                        points: [self.x, self.y, self.x + self.width, self.y]
                        width: 1

                PTextField:
                    id: search_field
                    hint_text: shape("جستجو در سیستم...")
                    icon_right: "magnify"
                    mode: "round"
                    size_hint_x: 0.4

                Widget:

                PLabel:
                    id: user_label
                    text: ""
                    # adaptive_width (نه text_size دستی): فرمول text_size خودِ
                    # MDLabel به self.adaptive_width وابسته است، پس همین یک
                    # پرچم هم عرض را خودکار می‌کند هم text_size[0] را پایدار
                    # None نگه می‌دارد (توضیح کامل در dashboard.kv)
                    adaptive_width: True
                    valign: "middle"

                MDIconButton:
                    icon: "bell-outline"

                MDIconButton:
                    icon: "theme-light-dark"
                    on_release: root.toggle_theme()

                MDIconButton:
                    icon: "logout"
                    on_release: root.log_out()

            MDScreenManager:
                id: content_manager

        # نوار کناری (راست)
        BoxLayout:
            orientation: "vertical"
            size_hint_x: None
            width: "280dp"
            padding: "12dp"
            spacing: "8dp"
            canvas.before:
                Color:
                    rgba: theme.SURFACE
                Rectangle:
                    pos: self.pos
                    size: self.size

            BoxLayout:
                size_hint_y: None
                height: "48dp"
                spacing: "10dp"

                MDIconButton:
                    icon: "printer-outline"
                    theme_text_color: "Custom"
                    text_color: theme.TEXT_SECONDARY

                Widget:

                PLabel:
                    text: shape("پیچا")
                    font_style: "H6"
                    halign: "right"
                    valign: "middle"

                MDBoxLayout:
                    size_hint: None, None
                    size: "36dp", "36dp"
                    radius: [12, 12, 12, 12]
                    md_bg_color: theme.PRIMARY

                    MDIcon:
                        icon: "chart-donut"
                        theme_text_color: "Custom"
                        text_color: 1, 1, 1, 1
                        halign: "center"
                        valign: "middle"

            BoxLayout:
                size_hint_y: None
                height: "1dp"
                canvas.before:
                    Color:
                        rgba: theme.DIVIDER
                    Rectangle:
                        pos: self.pos
                        size: self.size

            ScrollView:
                BoxLayout:
                    id: nav_list
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: "4dp"
                    padding: ["0dp", "12dp", "0dp", "0dp"]

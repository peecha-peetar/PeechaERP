#:import shape peecha.ui.rtl.shape
#:import tr peecha.ui.i18n.tr
#:import theme peecha.ui.theme
#:import NoTransition kivy.uix.screenmanager.NoTransition

<ShellScreen>:
    name: "shell"
    md_bg_color: theme.BACKGROUND

    BoxLayout:
        orientation: "horizontal"

        # محتوا (چپ)
        BoxLayout:
            orientation: "vertical"

            # نوار بالا — طبق مدرن‌سازیِ ظاهر: فاصله‌گذاریِ بیشتر + یک جداکننده‌ی
            # عمودیِ ظریف بینِ خوشه‌ی سوییچرهای زمینه (زبان/سال/شرکت) و
            # خوشه‌ی اکشن‌های کاربر (نام/زنگوله/تم/خروج)، تا شلوغیِ قبلی
            # (همه چسبیده به هم) به دو گروهِ قابل‌تشخیص تقسیم شود.
            BoxLayout:
                size_hint_y: None
                height: "64dp"
                padding: ["20dp", "8dp"]
                spacing: "16dp"
                canvas.before:
                    Color:
                        rgba: theme.SURFACE
                    Rectangle:
                        pos: self.pos
                        size: self.size
                    Color:
                        rgba: theme.DIVIDER
                    Line:
                        points: [self.x, self.y, self.x + self.width, self.y]
                        width: 1

                PTextField:
                    id: search_field
                    hint_text: ((app.ui_language_code or True) and shape(tr("جستجو در سیستم...")))
                    icon_right: "magnify"
                    mode: "round"
                    size_hint_x: 0.4

                Widget:

                # سوییچرِ زمینه: شرکتِ فعال / سالِ مالیِ فعال / زبان — طبق
                # درخواستِ صریح، محدود به شرکت‌هایی که خودِ کاربر (sec.user_companies)
                # به آن‌ها دسترسی دارد. عرضِ ثابت (نه size_hint_x پیش‌فرضِ ۱ خودِ
                # PSelectField) چون سه‌تا کنارِ هم‌اند و نباید بی‌رویه کش بیایند.
                PSelectField:
                    id: language_button
                    text: ""
                    size_hint_x: None
                    width: "110dp"
                    on_release: root.open_language_menu()

                PSelectField:
                    id: fiscal_year_button
                    text: ""
                    size_hint_x: None
                    width: "120dp"
                    on_release: root.open_fiscal_year_menu()

                PSelectField:
                    id: company_button
                    text: ""
                    size_hint_x: None
                    width: "190dp"
                    on_release: root.open_company_menu()

                Widget:
                    size_hint_x: None
                    width: "1dp"
                    canvas:
                        Color:
                            rgba: theme.DIVIDER
                        Rectangle:
                            pos: self.x, self.y + dp(14)
                            size: dp(1), self.height - dp(28)

                PLabel:
                    id: user_label
                    text: ""
                    # adaptive_width (نه text_size دستی): فرمول text_size خودِ
                    # MDLabel به self.adaptive_width وابسته است، پس همین یک
                    # پرچم هم عرض را خودکار می‌کند هم text_size[0] را پایدار
                    # None نگه می‌دارد (توضیح کامل در dashboard.kv)
                    adaptive_width: True
                    valign: "middle"

                MDIconButton:
                    icon: "bell-outline"

                MDIconButton:
                    icon: "theme-light-dark"
                    on_release: root.toggle_theme()

                MDIconButton:
                    icon: "logout"
                    on_release: root.log_out()

            MDScreenManager:
                id: content_manager
                # نوار کناری یک ناوبریِ ثابت/دائمی است (نه پشته‌ی صفحاتِ
                # موبایل)؛ ترنزیشنِ پیش‌فرضِ Kivy (اسلایدِ ۰.۴ ثانیه‌ای) باعث
                # می‌شد هر کلیک روی نوار کناری «تنبل»/دیر به‌نظر برسد — طبق
                # گزارشِ مستقیمِ کاربر.
                transition: NoTransition()

        # نوار کناری (راست) — طبق مدرن‌سازیِ ظاهر (نسخه‌ی دوم، بولدتر): پسِ‌زمینه‌ی
        # تیره‌ی کاملِ نوار کناری (الگوی رایجِ SaaS-هایِ ۲۰۲۶ مثلِ Linear/Vercel)
        # به‌جای سفیدِ قبلی — تفاوتش با یک نگاه مشخص است، نه یک ظرافتِ قابل‌چشم‌پوشی.
        BoxLayout:
            orientation: "vertical"
            size_hint_x: None
            # طبقِ درخواستِ صریح: نوار کناری وقتی لازم نیست خودکار جمع
            # می‌شود تا فضای بیشتری برایِ فرم‌ها بماند — پیش‌فرض جمع‌شده
            # (۶۴dp، فقط آیکون)، با دکمه‌ی زیر باز/بسته می‌شود.
            width: "64dp" if root.sidebar_collapsed else "280dp"
            padding: "12dp"
            spacing: "8dp"
            canvas.before:
                Color:
                    rgba: theme.PRIMARY
                Rectangle:
                    pos: self.pos
                    size: self.size

            BoxLayout:
                size_hint_y: None
                height: "48dp"
                spacing: "10dp"

                MDIconButton:
                    icon: "menu-open" if root.sidebar_collapsed else "menu"
                    theme_text_color: "Custom"
                    text_color: 1, 1, 1, 0.7
                    on_release: root.toggle_sidebar()

                Widget:
                    opacity: 0 if root.sidebar_collapsed else 1

                PLabel:
                    text: ((app.ui_language_code or True) and shape(tr("پیچا")))
                    font_style: "H6"
                    halign: "right"
                    valign: "middle"
                    theme_text_color: "Custom"
                    text_color: 1, 1, 1, 1
                    opacity: 0 if root.sidebar_collapsed else 1
                    size_hint_x: 0 if root.sidebar_collapsed else 1

                MDBoxLayout:
                    size_hint: None, None
                    size: ("0dp" if root.sidebar_collapsed else "36dp"), "36dp"
                    opacity: 0 if root.sidebar_collapsed else 1
                    radius: [12, 12, 12, 12]
                    md_bg_color: theme.ACCENT

                    MDIcon:
                        icon: "chart-donut"
                        theme_text_color: "Custom"
                        text_color: 1, 1, 1, 1
                        halign: "center"
                        valign: "middle"

            BoxLayout:
                size_hint_y: None
                height: "1dp"
                canvas.before:
                    Color:
                        rgba: 1, 1, 1, 0.1
                    Rectangle:
                        pos: self.pos
                        size: self.size

            ScrollView:
                BoxLayout:
                    id: nav_list
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: "4dp"
                    padding: ["0dp", "12dp", "0dp", "0dp"]

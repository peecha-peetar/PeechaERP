#:import shape peecha.ui.rtl.shape
#:import theme peecha.ui.theme
#:import dp kivy.metrics.dp

<JournalEntryLineRow>:
    orientation: "horizontal"
    size_hint_y: None
    height: "52dp"
    spacing: "8dp"
    padding: ["0dp", "2dp"]

    PSelectField:
        id: account_button
        text: shape("انتخاب حساب")
        size_hint_x: 0.32
        on_release: root.open_account_menu()

    PTextField:
        id: description_field
        hint_text: shape("شرح ردیف")
        size_hint_x: 0.26

    PTextField:
        id: debit_field
        hint_text: shape("بدهکار")
        size_hint_x: 0.16
        on_text: root.on_debit_changed()

    PTextField:
        id: credit_field
        hint_text: shape("بستانکار")
        size_hint_x: 0.16
        on_text: root.on_credit_changed()

    MDIconButton:
        icon: "close-circle-outline"
        theme_text_color: "Custom"
        text_color: theme.DANGER
        on_release: root.remove_line()


<JournalEntryScreen>:
    name: "journal_entry"
    md_bg_color: theme.BACKGROUND

    BoxLayout:
        orientation: "vertical"

        BoxLayout:
            size_hint_y: None
            height: "64dp"
            padding: ["24dp", "14dp"]
            canvas.before:
                Color:
                    rgba: theme.SURFACE
                Rectangle:
                    pos: self.pos
                    size: self.size
                Color:
                    rgba: theme.DIVIDER
                Line:
                    points: [self.x, self.y, self.x + self.width, self.y]
                    width: 1

            MDBoxLayout:
                size_hint: None, None
                size: self.minimum_width, dp(36)
                padding: "4dp"
                spacing: "4dp"
                radius: [20, 20, 20, 20]
                md_bg_color: theme.HOVER

                PTabButton:
                    text: shape("کدینگ حسابداری")
                    active: False
                    on_release: root.go_to_chart_of_accounts()

                PTabButton:
                    text: shape("صدور سند")
                    active: True

            Widget:

        ScrollView:
            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                padding: "24dp"
                spacing: "12dp"

                PCard:
                    size_hint_y: None
                    height: self.minimum_height

                    PLabel:
                        text: shape("صدور سند حسابداری")
                        font_style: "H5"
                        size_hint_y: None
                        height: self.texture_size[1]

                    BoxLayout:
                        size_hint_y: None
                        height: "48dp"
                        spacing: "12dp"

                        PTextField:
                            id: date_field
                            hint_text: shape("تاریخ سند (۱۴۰۳/۰۴/۲۸)")
                            size_hint_x: 0.3

                        PTextField:
                            id: description_field
                            hint_text: shape("شرح سند")
                            size_hint_x: 0.7

                    PLabel:
                        text: shape("ردیف‌ها")
                        font_style: "Subtitle1"
                        size_hint_y: None
                        height: self.texture_size[1]

                    BoxLayout:
                        id: lines_box
                        orientation: "vertical"
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: "6dp"

                    PFlatButton:
                        text: shape("+ افزودن ردیف")
                        theme_text_color: "Custom"
                        text_color: theme.ACCENT
                        size_hint_y: None
                        height: "36dp"
                        on_release: root.add_line()

                    MDBoxLayout:
                        size_hint_y: None
                        height: "56dp"
                        padding: ["16dp", "0dp"]
                        spacing: "20dp"
                        radius: [14, 14, 14, 14]
                        md_bg_color: theme.HOVER

                        PLabel:
                            id: total_debit_label
                            text: ""
                            theme_text_color: "Custom"
                            text_color: theme.TEXT_PRIMARY
                            valign: "middle"

                        PLabel:
                            id: total_credit_label
                            text: ""
                            theme_text_color: "Custom"
                            text_color: theme.TEXT_PRIMARY
                            valign: "middle"

                        Widget:

                        MDBoxLayout:
                            id: balance_chip
                            size_hint: None, None
                            size: self.minimum_width, dp(30)
                            padding: ["14dp", "0dp"]
                            radius: [15, 15, 15, 15]
                            md_bg_color: theme.DANGER[0], theme.DANGER[1], theme.DANGER[2], 0.12
                            pos_hint: {"center_y": 0.5}

                            PLabel:
                                id: balance_label
                                text: ""
                                theme_text_color: "Custom"
                                text_color: theme.DANGER
                                halign: "center"
                                valign: "middle"
                                # adaptive_width: توضیح در dashboard.kv/widgets.kv (PTabButton)
                                adaptive_width: True

                    PHintLabel:
                        id: status_label
                        text: ""
                        theme_text_color: "Custom"
                        text_color: theme.TEXT_SECONDARY

                    PRaisedButton:
                        text: shape("ثبت سند")
                        on_release: root.submit()

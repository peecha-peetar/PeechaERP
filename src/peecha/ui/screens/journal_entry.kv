#:import shape peecha.ui.rtl.shape
#:import tr peecha.ui.i18n.tr
#:import theme peecha.ui.theme
#:import dp kivy.metrics.dp

# ردیفِ یک نتیجه‌ی جستجو در منوی کشوییِ AccountSearchField.
<_AccountOptionRow>:
    size_hint_y: None
    height: "36dp"
    padding: ["10dp", "0dp"]
    md_bg_color: theme.SELECTED if root.highlighted else (0, 0, 0, 0)

    PLabel:
        text: root.label_text
        valign: "middle"

# ردیفِ یک پیشنهادِ شرح در منوی کشوییِ LineDescriptionField.
<_SuggestionRow>:
    size_hint_y: None
    height: "36dp"
    padding: ["10dp", "0dp"]
    md_bg_color: theme.SELECTED if root.highlighted else (0, 0, 0, 0)

    PLabel:
        text: root.label_text
        valign: "middle"

# ردیفِ یک نتیجه‌ی جستجو در منوی کشوییِ _DimensionSearchField (مرکز هزینه/پروژه).
<_DimensionOptionRow>:
    size_hint_y: None
    height: "36dp"
    padding: ["10dp", "0dp"]
    md_bg_color: theme.SELECTED if root.highlighted else (0, 0, 0, 0)

    PLabel:
        text: root.label_text
        valign: "middle"

# نکته‌ی مهمِ RTL (همه‌جای این فایل): در BoxLayout افقیِ Kivy فرزندِ
# اول‌اعلام‌شده همیشه چپ‌ترین می‌شود (تست مستقیم تایید کرد، Kivy خودش پرچم
# RTL برای BoxLayout ندارد)؛ برای این‌که ستون‌ها/فیلدها به ترتیب درستِ
# خواندنِ راست‌به‌چپ بیفتند، ترتیبِ اعلام در KV عمداً برعکسِ ترتیب منطقی است.
<JournalEntryLineRow>:
    orientation: "horizontal"
    size_hint_y: None
    height: "52dp"
    spacing: "8dp"
    padding: ["0dp", "2dp"]

    MDIconButton:
        icon: "close-circle-outline"
        theme_text_color: "Custom"
        text_color: theme.DANGER
        on_release: root.remove_line()

    # طبق درخواستِ صریح («ابعادِ تفصیلی/مراکزِ هزینه»): این آیکون فقط وقتی
    # نمایش داده می‌شود که حسابِ انتخاب‌شده‌ی این ردیف نوع‌بُعدِ تفصیلیِ
    # الزامی داشته باشد؛ رنگش هشدارمی‌دهد اگر هنوز همه‌ی ابعاد پر نشده باشند.
    MDIconButton:
        icon: "shape-outline"
        icon_size: "12sp"
        size_hint_x: None
        width: "36dp"
        opacity: 1 if root.has_required_dims else 0
        disabled: not root.has_required_dims
        theme_text_color: "Custom"
        text_color: theme.SUCCESS if root.dims_complete else theme.WARNING
        on_release: root.open_dimensions_dialog()

    # طبق درخواستِ صریح («چندارزی/نرخِ تسعیر»): این آیکون فقط وقتی نمایش
    # داده می‌شود که شرکتِ جاری بیش از یک ارزِ قابلِ معامله داشته باشد
    # (وگرنه برای حالتِ رایجِ تک‌ارزی شلوغی بی‌فایده است)؛ رنگش نشان می‌دهد
    # آیا ردیف با ارزِ پایه ثبت می‌شود یا ارزِ دیگری انتخاب شده.
    MDIconButton:
        icon: "cash-multiple"
        icon_size: "12sp"
        size_hint_x: None
        width: "36dp"
        opacity: 1 if root.has_multi_currency else 0
        disabled: not root.has_multi_currency
        theme_text_color: "Custom"
        text_color: theme.TEXT_SECONDARY if root.currency_is_base else theme.ACCENT
        on_release: root.open_currency_dialog()

    PAmountField:
        id: credit_field
        hint_text: ((app.ui_language_code or True) and shape(tr("بستانکار")))
        size_hint_x: 0.13
        on_text: root.on_credit_changed()
        on_text_validate: root.request_next()
        on_focus: root.on_amount_focus(self)
        focus_previous: debit_field

    PAmountField:
        id: debit_field
        hint_text: ((app.ui_language_code or True) and shape(tr("بدهکار")))
        size_hint_x: 0.13
        on_text: root.on_debit_changed()
        # طبق درخواستِ صریح: اگر بدهکار پر شده باشد Enter به ردیفِ بعد
        # می‌رود؛ اگر صفر/خالی باشد (یعنی این ردیف بستانکار است) Enter به
        # فیلدِ بستانکارِ همین ردیف می‌رود، نه ردیفِ بعد.
        on_text_validate: root.on_debit_validate()
        on_focus: root.on_amount_focus(self)
        focus_next: credit_field
        # focus_previous واقعی (سمتِ LineDescriptionField) در پایتون وصل
        # می‌شود (JournalEntryLineRow.__init__)، همان‌طور که account_field.

    # جایگاهِ LineDescriptionField — چون این ویجت برای پیشنهادِ زنده به
    # فهرستِ شرح‌های قبلیِ همین شرکت نیاز دارد (در KV قابل‌تعریف نیست)، در
    # پایتون ساخته و همین‌جا جاگذاری می‌شود (JournalEntryLineRow.__init__).
    BoxLayout:
        id: description_slot
        size_hint_x: 0.30

    # جایگاهِ PersonSearchField (ستونِ تفصیلی) — طبقِ درخواستِ صریح، تفصیلیِ
    # حسابِ انتخاب‌شده باید کنارِ خودِ حساب و همیشه قابل‌انتخاب باشد (نه پشتِ
    # آیکون مثلِ سایرِ ابعاد)؛ چون به داده‌ی مخصوصِ هر نمونه نیاز دارد، در
    # پایتون ساخته و همین‌جا جاگذاری می‌شود (JournalEntryLineRow.__init__).
    BoxLayout:
        id: person_slot
        size_hint_x: 0.16

    # جایگاهِ AccountSearchField — چون این ویجت به داده‌ی مخصوصِ هر نمونه
    # (فهرستِ حساب‌ها، کال‌بکِ انتخاب) نیاز دارد که در KV قابل‌تعریف نیست،
    # در پایتون ساخته و همین‌جا جاگذاری می‌شود (JournalEntryLineRow.__init__).
    BoxLayout:
        id: account_slot
        size_hint_x: 0.20

<JournalEntryScreen>:
    name: "journal_entry"
    md_bg_color: theme.BACKGROUND

    BoxLayout:
        # طبق درخواستِ صریح: هدر و فوترِ سند ثابت بمانند، فقط خودِ فهرستِ
        # ردیف‌ها بالا/پایین برود — قبلاً کل صفحه (هدر+ردیف‌ها+فوتر) در یک
        # ScrollView واحد بود، پس با زیادشدنِ ردیف‌ها هدر (تاریخ/شرح سند) و
        # فوتر (جمع بدهکار/بستانکار، دکمه‌ی ثبت) هم از دید خارج می‌شدند.
        # این‌جا سه PCardِ جدا: هدر (ثابت)، ردیف‌ها (کشسان، خودش اسکرول
        # می‌کند)، فوتر (ثابت) — همان الگویِ chart_of_accounts/
        # journal_entries_list.
        orientation: "vertical"
        padding: "24dp"
        spacing: "12dp"

        PCard:
            size_hint_y: None
            height: self.minimum_height

            PLabel:
                id: form_title
                text: ((app.ui_language_code or True) and shape(tr("صدور سند حسابداری")))
                font_style: "H5"
                size_hint_y: None
                height: self.texture_size[1]

            BoxLayout:
                size_hint_y: None
                height: "48dp"
                spacing: "12dp"

                PTextField:
                    id: description_field
                    hint_text: ((app.ui_language_code or True) and shape(tr("شرح سند")))
                    size_hint_x: 0.7
                    focus_previous: date_field
                    # طبق درخواستِ صریح: با Enter به اولین فیلدِ حسابِ
                    # ردیف‌ها می‌رود (focus_next پویا در _relink_row_focus
                    # به‌روز می‌شود، پس همیشه به ردیفِ درستی اشاره دارد).
                    on_text_validate: self.focus_next.focus = True if self.focus_next else None

                PTextField:
                    id: date_field
                    hint_text: ((app.ui_language_code or True) and shape(tr("تاریخ سند (۱۴۰۳/۰۴/۲۸)")))
                    size_hint_x: 0.3
                    persian_digits: True
                    focus_next: description_field
                    # طبق درخواستِ صریح: نقطه‌ی شروعِ کیبوردِ سند تاریخ
                    # است؛ Enter به شرحِ سند می‌رود.
                    on_text_validate: self.focus_next.focus = True

            BoxLayout:
                size_hint_y: None
                height: "48dp"
                spacing: "12dp"

                PHintLabel:
                    id: registration_at_label
                    text: ""
                    size_hint_x: 0.3

                MDCheckbox:
                    id: draft_checkbox
                    size_hint: None, None
                    size: "24dp", "24dp"
                    pos_hint: {"center_y": 0.5}

                PLabel:
                    text: ((app.ui_language_code or True) and shape(tr("ذخیره به عنوان پیش‌نویس")))
                    valign: "middle"
                    size_hint_x: None
                    width: "170dp"

                PTextField:
                    id: alternative_number_field
                    hint_text: ((app.ui_language_code or True) and shape(tr("شماره عطف/بایگانی")))
                    size_hint_x: 0.3
                    focus_previous: description_field
                    on_text_validate: self.focus_next.focus = True if self.focus_next else None

        PCard:
            PLabel:
                text: ((app.ui_language_code or True) and shape(tr("ردیف‌ها")))
                font_style: "Subtitle1"
                size_hint_y: None
                height: self.texture_size[1]

            # هدرِ ستون‌ها: عرض هر ستون دقیقاً باید با size_hint_x معادلش
            # در <JournalEntryLineRow> یکی باشد وگرنه زیر هم نمی‌نشینند.
            # نکته‌ی مهم: سه‌تا آیکونِ ابتدای هر ردیف (بستن/ابعاد/ارز) عرضِ
            # ثابت (پیکسلی) دارند، نه size_hint_x — پس این جایگاهِ خالیِ
            # هم‌ارزشان در هدر هم باید یک Widget با عرضِ ثابتِ دقیقاً برابر
            # باشد (نه یک Widget با size_hint پیش‌فرض که با بقیه‌ی ستون‌ها
            # رقابتِ نسبی می‌کند و باعثِ جابه‌جاشدنِ کل هدر می‌شود): آیکونِ
            # بستن (پیش‌فرضِ ۴۸dp‌ی MDIconButton) + ۸dp فاصله + آیکونِ ابعاد
            # (۳۶dp) + ۸dp فاصله + آیکونِ ارز (۳۶dp) + ۸dp فاصله تا فیلدِ
            # بستانکار = ۱۴۴dp.
            BoxLayout:
                size_hint_y: None
                height: "24dp"
                spacing: "8dp"

                Widget:
                    size_hint_x: None
                    width: "144dp"

                PLabel:
                    text: ((app.ui_language_code or True) and shape(tr("بستانکار")))
                    font_style: "Caption"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: theme.TEXT_SECONDARY
                    valign: "middle"
                    size_hint_x: 0.13

                PLabel:
                    text: ((app.ui_language_code or True) and shape(tr("بدهکار")))
                    font_style: "Caption"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: theme.TEXT_SECONDARY
                    valign: "middle"
                    size_hint_x: 0.13

                PLabel:
                    text: ((app.ui_language_code or True) and shape(tr("شرح ردیف")))
                    font_style: "Caption"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: theme.TEXT_SECONDARY
                    valign: "middle"
                    size_hint_x: 0.30

                PLabel:
                    text: ((app.ui_language_code or True) and shape(tr("تفصیلی")))
                    font_style: "Caption"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: theme.TEXT_SECONDARY
                    valign: "middle"
                    size_hint_x: 0.16

                PLabel:
                    text: ((app.ui_language_code or True) and shape(tr("حساب")))
                    font_style: "Caption"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: theme.TEXT_SECONDARY
                    valign: "middle"
                    size_hint_x: 0.20

            # فقط همین ScrollView (نه کلِ صفحه) بالا/پایین می‌رود — طبق
            # درخواستِ صریح، هدر/فوترِ سند ثابت می‌مانند.
            ScrollView:
                do_scroll_x: False
                bar_width: "8dp"
                scroll_type: ["bars", "content"]
                bar_color: theme.ACCENT
                bar_inactive_color: theme.BORDER[0], theme.BORDER[1], theme.BORDER[2], 0.6

                BoxLayout:
                    id: lines_box
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: "6dp"

            PFlatButton:
                id: add_line_button
                text: ((app.ui_language_code or True) and shape(tr("+ افزودن ردیف")))
                theme_text_color: "Custom"
                text_color: theme.ACCENT
                size_hint_y: None
                height: "36dp"
                on_release: root.add_line()
                focus_next: save_button

        PCard:
            size_hint_y: None
            height: self.minimum_height

            MDBoxLayout:
                size_hint_y: None
                height: "56dp"
                padding: ["16dp", "0dp"]
                spacing: "20dp"
                radius: [14, 14, 14, 14]
                md_bg_color: theme.HOVER

                MDBoxLayout:
                    id: balance_chip
                    size_hint: None, None
                    size: self.minimum_width, dp(30)
                    padding: ["14dp", "0dp"]
                    radius: [15, 15, 15, 15]
                    md_bg_color: theme.DANGER[0], theme.DANGER[1], theme.DANGER[2], 0.12
                    pos_hint: {"center_y": 0.5}

                    PLabel:
                        id: balance_label
                        text: ""
                        theme_text_color: "Custom"
                        text_color: theme.DANGER
                        halign: "center"
                        valign: "middle"
                        # adaptive_width: توضیح در dashboard.kv/widgets.kv
                        adaptive_width: True

                Widget:

                PLabel:
                    id: total_credit_label
                    text: ""
                    theme_text_color: "Custom"
                    text_color: theme.TEXT_PRIMARY
                    valign: "middle"

                PLabel:
                    id: total_debit_label
                    text: ""
                    theme_text_color: "Custom"
                    text_color: theme.TEXT_PRIMARY
                    valign: "middle"

            # طبق درخواستِ صریح: مبلغِ واردشده (در هر فیلدِ بدهکار/بستانکار
            # از هر ردیف) به‌صورتِ زنده زیرِ فرم به حروف نمایش داده می‌شود.
            PHintLabel:
                id: amount_words_label
                text: ""
                theme_text_color: "Custom"
                text_color: theme.TEXT_SECONDARY

            PHintLabel:
                id: status_label
                text: ""
                theme_text_color: "Custom"
                text_color: theme.TEXT_SECONDARY

            BoxLayout:
                size_hint_y: None
                height: "48dp"
                spacing: "8dp"

                PFlatButton:
                    id: cancel_edit_button
                    text: ((app.ui_language_code or True) and shape(tr("لغو ویرایش (Esc)")))
                    theme_text_color: "Custom"
                    text_color: theme.TEXT_SECONDARY
                    opacity: 0
                    disabled: True
                    focus_previous: save_button
                    size_hint_y: None
                    height: "0dp"
                    on_release: root.cancel_edit()

                PRaisedButton:
                    id: save_button
                    text: ((app.ui_language_code or True) and shape(tr("ثبت سند")))
                    on_release: root.save_entry()
                    focus_previous: add_line_button
                    focus_next: cancel_edit_button

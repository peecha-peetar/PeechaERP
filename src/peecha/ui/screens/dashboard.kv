#:import shape peecha.ui.rtl.shape
#:import tr peecha.ui.i18n.tr
#:import theme peecha.ui.theme

<DashboardScreen>:
    name: "dashboard"
    md_bg_color: theme.BACKGROUND

    ScrollView:
        BoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: self.minimum_height
            padding: "32dp"
            spacing: "24dp"

            PLabel:
                text: ((app.ui_language_code or True) and shape(tr("داشبورد اصلی")))
                font_style: "H4"
                size_hint_y: None
                height: self.texture_size[1]

            PLabel:
                text: ((app.ui_language_code or True) and shape(tr("خلاصه‌ی وضعیت سیستم")))
                theme_text_color: "Custom"
                text_color: theme.TEXT_SECONDARY
                size_hint_y: None
                height: self.texture_size[1]

            BoxLayout:
                size_hint_y: None
                height: "156dp"
                spacing: "20dp"

                PStatCard:
                    id: card_companies
                    icon: "domain"
                    icon_bg_color: theme.ACCENT
                    title: ((app.ui_language_code or True) and shape(tr("شرکت‌ها")))
                    value: "0"

                PStatCard:
                    id: card_users
                    icon: "account-multiple-outline"
                    icon_bg_color: theme.SUCCESS
                    title: ((app.ui_language_code or True) and shape(tr("کاربران")))
                    value: "0"

                PStatCard:
                    id: card_accounts
                    icon: "format-list-bulleted"
                    icon_bg_color: theme.CHART_PURPLE
                    title: ((app.ui_language_code or True) and shape(tr("حساب‌های تعریف‌شده")))
                    value: "0"

                PStatCard:
                    id: card_entries
                    icon: "file-document-outline"
                    icon_bg_color: theme.CHART_ORANGE
                    title: ((app.ui_language_code or True) and shape(tr("اسناد حسابداری")))
                    value: "0"

            BoxLayout:
                size_hint_y: None
                height: "340dp"
                spacing: "20dp"

                PCard:
                    size_hint_x: 0.65

                    PLabel:
                        text: ((app.ui_language_code or True) and shape(tr("اسناد حسابداری ثبت‌شده (۶ ماه اخیر)")))
                        font_style: "Subtitle1"
                        size_hint_y: None
                        height: self.texture_size[1]

                    RelativeLayout:
                        LineAreaChart:
                            id: entries_chart

                        PLabel:
                            id: entries_chart_empty
                            text: ""
                            halign: "center"
                            # adaptive_size (نه ست‌کردن دستی text_size/size_hint/size):
                            # فرمول text_size خودِ MDLabel به self.width وابسته است و
                            # با هر تغییر width دوباره اجرا می‌شود؛ اگر جدا از آن یک
                            # text_size ثابت بدهیم، هر بار توسط همان فرمول رونویسی
                            # می‌شود. adaptive_size همان فرمول را با شرط خودش به
                            # (None, None) می‌رساند و پایدار می‌ماند.
                            adaptive_size: True
                            pos_hint: {"center_x": 0.5, "center_y": 0.5}

                PCard:
                    size_hint_x: 0.35

                    PLabel:
                        text: ((app.ui_language_code or True) and shape(tr("ترکیب کدینگ حسابداری")))
                        font_style: "Subtitle1"
                        size_hint_y: None
                        height: self.texture_size[1]

                    RelativeLayout:
                        size_hint_y: 0.7

                        DonutChart:
                            id: accounts_donut

                        PLabel:
                            id: accounts_donut_empty
                            text: ""
                            halign: "center"
                            adaptive_size: True
                            pos_hint: {"center_x": 0.5, "center_y": 0.5}

                    PLabel:
                        id: accounts_legend
                        text: ""
                        halign: "right"
                        size_hint_y: None
                        height: self.texture_size[1]

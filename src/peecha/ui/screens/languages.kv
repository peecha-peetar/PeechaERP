#:import shape peecha.ui.rtl.shape
#:import theme peecha.ui.theme
#:import dp kivy.metrics.dp

# نکته‌ی مهمِ RTL: در BoxLayout افقیِ Kivy فرزندِ اول‌اعلام‌شده همیشه
# چپ‌ترین می‌شود (تست مستقیم تایید کرد)؛ برای این‌که «کد» راست‌ترین بیفتد،
# ترتیبِ اعلام در KV عمداً برعکسِ ترتیب منطقیِ ستون‌هاست (مثل chart_of_accounts.kv).
<LanguageRowWidget>:
    orientation: "horizontal"
    size_hint_y: None
    height: "40dp"
    padding: ["12dp", "0dp"]
    radius: [8, 8, 8, 8]
    md_bg_color: theme.SELECTED if root.selected else (theme.HOVER if root.zebra else (0, 0, 0, 0))

    MDIconButton:
        icon: "trash-can-outline"
        icon_size: "18sp"
        size_hint_x: None
        width: "28dp"
        theme_text_color: "Custom"
        text_color: theme.DANGER
        on_release: root.request_delete()

    MDIconButton:
        icon: "pencil-outline"
        icon_size: "18sp"
        size_hint_x: None
        width: "28dp"
        theme_text_color: "Custom"
        text_color: theme.ACCENT
        on_release: root.on_release()

    AnchorLayout:
        size_hint_x: 0.16
        anchor_x: "right"
        anchor_y: "center"

        PBadge:
            text: root.status_text
            badge_color: theme.SUCCESS if root.is_active_row else theme.TEXT_DISABLED

    AnchorLayout:
        size_hint_x: 0.16
        anchor_x: "right"
        anchor_y: "center"

        PBadge:
            text: root.default_text
            badge_color: theme.ACCENT

    PLabel:
        text: root.direction_text
        theme_text_color: "Custom"
        text_color: theme.TEXT_SECONDARY
        valign: "middle"
        size_hint_x: 0.24

    PLabel:
        text: root.name_text
        valign: "middle"
        size_hint_x: 0.28

    PLabel:
        text: root.code_text
        theme_text_color: "Custom"
        text_color: theme.TEXT_SECONDARY
        valign: "middle"
        size_hint_x: 0.16

<LanguagesScreen>:
    name: "languages"
    md_bg_color: theme.BACKGROUND

    BoxLayout:
        orientation: "horizontal"
        padding: "24dp"
        spacing: "20dp"

        PCard:
            size_hint_x: 0.62

            PLabel:
                text: shape("زبان‌های سیستم")
                font_style: "H5"
                size_hint_y: None
                height: self.texture_size[1]

            PHintLabel:
                id: status_label
                text: ""

            BoxLayout:
                id: grid_header
                size_hint_y: None
                height: "32dp"
                padding: ["12dp", "0dp"]

                Widget:
                    size_hint_x: None
                    width: "56dp"

                PLabel:
                    text: shape("وضعیت")
                    font_style: "Caption"
                    theme_text_color: "Custom"
                    text_color: theme.TEXT_SECONDARY
                    halign: "right"
                    valign: "middle"
                    size_hint_x: 0.16

                PLabel:
                    text: shape("پیش‌فرض")
                    font_style: "Caption"
                    theme_text_color: "Custom"
                    text_color: theme.TEXT_SECONDARY
                    halign: "right"
                    valign: "middle"
                    size_hint_x: 0.16

                PLabel:
                    text: shape("جهت")
                    font_style: "Caption"
                    theme_text_color: "Custom"
                    text_color: theme.TEXT_SECONDARY
                    valign: "middle"
                    size_hint_x: 0.24

                PLabel:
                    text: shape("نام")
                    font_style: "Caption"
                    theme_text_color: "Custom"
                    text_color: theme.TEXT_SECONDARY
                    valign: "middle"
                    size_hint_x: 0.28

                PLabel:
                    text: shape("کد")
                    font_style: "Caption"
                    theme_text_color: "Custom"
                    text_color: theme.TEXT_SECONDARY
                    valign: "middle"
                    size_hint_x: 0.16

            ScrollView:
                BoxLayout:
                    id: languages_list
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: "2dp"

        PCard:
            size_hint_x: 0.38
            spacing: "14dp"

            PLabel:
                id: form_title
                text: shape("افزودن زبان جدید")
                font_style: "Subtitle1"
                size_hint_y: None
                height: self.texture_size[1]

            PTextField:
                id: code_field
                hint_text: shape("کد زبان (مثلاً fa-IR)")
                focus_next: name_field

            PTextField:
                id: name_field
                hint_text: shape("نام زبان (مثلاً فارسی)")
                focus_next: sort_order_field
                focus_previous: code_field

            PTextField:
                id: sort_order_field
                hint_text: shape("ترتیبِ نمایش")
                persian_digits: True
                focus_next: save_button
                focus_previous: name_field
                on_text_validate: root.save_language()

            BoxLayout:
                size_hint_y: None
                height: "36dp"
                spacing: "8dp"

                MDCheckbox:
                    id: is_rtl_checkbox
                    size_hint: None, None
                    size: "24dp", "24dp"
                    pos_hint: {"center_y": 0.5}

                PLabel:
                    text: shape("راست‌به‌چپ (RTL)")
                    valign: "middle"

            BoxLayout:
                size_hint_y: None
                height: "36dp"
                spacing: "8dp"

                MDCheckbox:
                    id: is_default_checkbox
                    size_hint: None, None
                    size: "24dp", "24dp"
                    pos_hint: {"center_y": 0.5}

                PLabel:
                    text: shape("زبانِ پیش‌فرض سیستم")
                    valign: "middle"

            BoxLayout:
                size_hint_y: None
                height: "36dp"
                spacing: "8dp"

                MDCheckbox:
                    id: is_active_checkbox
                    active: True
                    size_hint: None, None
                    size: "24dp", "24dp"
                    pos_hint: {"center_y": 0.5}

                PLabel:
                    text: shape("فعال")
                    valign: "middle"

            Widget:

            PRaisedButton:
                id: save_button
                text: shape("افزودن زبان")
                on_release: root.save_language()
                focus_previous: sort_order_field
                focus_next: cancel_edit_button

            PFlatButton:
                id: cancel_edit_button
                text: shape("لغو ویرایش (Esc)")
                theme_text_color: "Custom"
                text_color: theme.TEXT_SECONDARY
                opacity: 0
                disabled: True
                size_hint_y: None
                height: "0dp"
                on_release: root.cancel_edit()
                focus_previous: save_button

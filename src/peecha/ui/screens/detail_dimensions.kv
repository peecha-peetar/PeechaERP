#:import shape peecha.ui.rtl.shape
#:import tr peecha.ui.i18n.tr
#:import theme peecha.ui.theme
#:import dp kivy.metrics.dp

# نکته‌ی مهمِ RTL (همه‌جای این فایل): مثلِ بقیه‌ی صفحه‌ها، ترتیبِ اعلامِ
# ستون‌های افقی عمداً برعکسِ ترتیبِ منطقیِ خواندنِ راست‌به‌چپ است.
<DimensionTypeRowWidget>:
    orientation: "horizontal"
    size_hint_y: None
    height: "36dp"
    padding: ["10dp", "0dp"]
    md_bg_color: theme.SELECTED if root.selected else (theme.GRID_ROW_ALT if root.zebra else theme.SURFACE)
    canvas.after:
        Color:
            rgba: theme.GRID_BORDER
        Line:
            points: [self.x, self.y, self.x + self.width, self.y]
            width: 1

    MDIconButton:
        icon: "trash-can-outline"
        icon_size: "12sp"
        size_hint_x: None
        width: "36dp"
        theme_text_color: "Custom"
        text_color: theme.DANGER
        on_release: root.request_delete()

    AnchorLayout:
        size_hint_x: 0.22
        anchor_x: "right"
        anchor_y: "center"

        PBadge:
            text: root.status_text
            badge_color: theme.SUCCESS if root.is_active_row else theme.TEXT_DISABLED

    PLabel:
        text: root.count_text
        theme_text_color: "Custom"
        text_color: theme.TEXT_SECONDARY
        halign: "right"
        valign: "middle"
        size_hint_x: 0.18

    PLabel:
        text: root.code_text
        valign: "middle"
        size_hint_x: 0.6

<DetailAccountRowWidget>:
    orientation: "horizontal"
    size_hint_y: None
    height: "36dp"
    padding: ["10dp", "0dp"]
    md_bg_color: theme.SELECTED if root.selected else (theme.GRID_ROW_ALT if root.zebra else theme.SURFACE)
    canvas.after:
        Color:
            rgba: theme.GRID_BORDER
        Line:
            points: [self.x, self.y, self.x + self.width, self.y]
            width: 1

    MDIconButton:
        icon: "trash-can-outline"
        icon_size: "12sp"
        size_hint_x: None
        width: "36dp"
        theme_text_color: "Custom"
        text_color: theme.DANGER
        on_release: root.request_delete()

    AnchorLayout:
        size_hint_x: 0.28
        anchor_x: "right"
        anchor_y: "center"

        PBadge:
            text: root.status_text
            badge_color: theme.SUCCESS if root.is_active_row else theme.TEXT_DISABLED

    PLabel:
        text: root.code_text
        valign: "middle"
        size_hint_x: 0.72

# ردیفِ ویرایشِ یک فیلدِ اختصاصیِ گروه (کلید/برچسب/نوع/الزامی/حذف) — طبقِ
# درخواستِ صریح، کاربر خودش برایِ گروهِ تازه‌تعریف‌شده (مثلِ «بانک») این‌ها
# را تعریف می‌کند.
<GroupFieldEditRow>:
    orientation: "horizontal"
    size_hint_y: None
    height: "40dp"
    spacing: "6dp"

    MDIconButton:
        icon: "trash-can-outline"
        icon_size: "12sp"
        size_hint_x: None
        width: "36dp"
        theme_text_color: "Custom"
        text_color: theme.DANGER
        on_release: root.remove()

    MDCheckbox:
        id: required_checkbox
        size_hint: None, None
        size: "24dp", "24dp"
        pos_hint: {"center_y": 0.5}

    PSelectField:
        id: kind_button
        text: ""
        size_hint_x: 0.24
        on_release: root.open_kind_menu()

    PTextField:
        id: label_field
        hint_text: ((app.ui_language_code or True) and shape(tr("برچسب")))
        size_hint_x: 0.32

    PTextField:
        id: key_field
        hint_text: ((app.ui_language_code or True) and shape(tr("کلید (انگلیسی)")))
        size_hint_x: 0.32

<DetailDimensionsScreen>:
    name: "detail_dimensions"
    md_bg_color: theme.BACKGROUND

    BoxLayout:
        orientation: "horizontal"
        padding: "24dp"
        spacing: "20dp"

        PCard:
            size_hint_x: 0.68
            spacing: "12dp"

            PLabel:
                id: accounts_title
                text: ((app.ui_language_code or True) and shape(tr("حساب‌های تفصیلی")))
                font_style: "H5"
                size_hint_y: None
                height: self.texture_size[1]

            PHintLabel:
                id: accounts_empty_label
                text: ((app.ui_language_code or True) and shape(tr("ابتدا از پنلِ روبه‌رو یک نوع‌بُعد (مثلاً «مرکز هزینه») بسازید یا انتخاب کنید.")))

            BoxLayout:
                id: accounts_panel
                orientation: "vertical"
                spacing: "12dp"
                disabled: True
                opacity: 0

                PHintLabel:
                    id: account_status_label
                    text: ""

                BoxLayout:
                    size_hint_y: None
                    height: "48dp"
                    spacing: "12dp"

                    PTextField:
                        id: account_code_field
                        hint_text: ((app.ui_language_code or True) and shape(tr("کدِ حسابِ تفصیلی (مثلاً مرکزِ هزینه‌ی فروش)")))
                        size_hint_x: 0.6
                        focus_next: account_save_button
                        on_text_validate: root.save_detail_account()

                    MDCheckbox:
                        id: account_active_checkbox
                        active: True
                        size_hint: None, None
                        size: "24dp", "24dp"
                        pos_hint: {"center_y": 0.5}

                    PLabel:
                        text: ((app.ui_language_code or True) and shape(tr("فعال")))
                        valign: "middle"
                        size_hint_x: None
                        width: "50dp"

                # طبقِ درخواستِ صریح («تا ۴ سطح تفصیلی»): انتخابِ والد، برایِ
                # ساختنِ سلسله‌مراتب — اختیاری، پیش‌فرض «بدون والد» یعنی سطحِ ۱.
                PSelectField:
                    id: account_parent_button
                    text: ""
                    on_release: root.open_parent_menu()

                # فیلدهای اختصاصیِ همین گروه (اگر تعریف شده باشند) — طبقِ
                # درخواستِ صریح، پویا بر اساسِ acc.detail_group_fields ساخته
                # می‌شود (در پایتون، چون تعدادشان متغیر است).
                BoxLayout:
                    id: account_extra_fields_box
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: "4dp"

                BoxLayout:
                    size_hint_y: None
                    height: "40dp"
                    spacing: "8dp"

                    PRaisedButton:
                        id: account_save_button
                        text: ((app.ui_language_code or True) and shape(tr("افزودن")))
                        on_release: root.save_detail_account()
                        focus_previous: account_code_field
                        focus_next: account_cancel_button

                    PFlatButton:
                        id: account_cancel_button
                        text: ((app.ui_language_code or True) and shape(tr("لغو ویرایش (Esc)")))
                        theme_text_color: "Custom"
                        text_color: theme.TEXT_SECONDARY
                        opacity: 0
                        disabled: True
                        size_hint_x: None
                        width: "0dp"
                        on_release: root.cancel_account_edit()
                        focus_previous: account_save_button

                BoxLayout:
                    size_hint_y: None
                    height: "36dp"
                    padding: ["10dp", "0dp"]
                    canvas.before:
                        Color:
                            rgba: theme.GRID_HEADER_BG
                        Rectangle:
                            pos: self.pos
                            size: self.size
                        Color:
                            rgba: theme.GRID_BORDER
                        Line:
                            points: [self.x, self.y, self.x + self.width, self.y]
                            width: 1

                    Widget:
                        size_hint_x: None
                        width: "36dp"

                    PLabel:
                        text: ((app.ui_language_code or True) and shape(tr("وضعیت")))
                        font_style: "Caption"
                        bold: True
                        theme_text_color: "Custom"
                        text_color: theme.TEXT_SECONDARY
                        halign: "right"
                        valign: "middle"
                        size_hint_x: 0.28

                    PLabel:
                        text: ((app.ui_language_code or True) and shape(tr("کد")))
                        font_style: "Caption"
                        bold: True
                        theme_text_color: "Custom"
                        text_color: theme.TEXT_SECONDARY
                        valign: "middle"
                        size_hint_x: 0.72

                RecycleView:
                    id: accounts_list
                    viewclass: "DetailAccountRowWidget"
                    bar_width: "8dp"
                    scroll_type: ["bars", "content"]
                    bar_color: theme.ACCENT
                    bar_inactive_color: theme.BORDER[0], theme.BORDER[1], theme.BORDER[2], 0.6

                    RecycleBoxLayout:
                        orientation: "vertical"
                        default_size_hint: 1, None
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: "0dp"

        PCard:
            size_hint_x: 0.32
            spacing: "14dp"

            PLabel:
                text: ((app.ui_language_code or True) and shape(tr("نوع‌های بُعدِ تفصیلی")))
                font_style: "H5"
                size_hint_y: None
                height: self.texture_size[1]

            PHintLabel:
                text: ((app.ui_language_code or True) and shape(tr("مثلاً مرکزِ هزینه، پروژه، مشتری — هر سند می‌تواند بر اساسِ این ابعاد تفکیک شود.")))

            PHintLabel:
                id: status_label
                text: ""

            PLabel:
                id: type_form_title
                text: ((app.ui_language_code or True) and shape(tr("افزودنِ نوع‌بُعدِ تازه")))
                font_style: "Subtitle1"
                size_hint_y: None
                height: self.texture_size[1]

            PTextField:
                id: type_code_field
                hint_text: ((app.ui_language_code or True) and shape(tr("کد (مثلاً COST_CENTER)")))
                focus_next: type_save_button
                on_text_validate: root.save_dimension_type()

            BoxLayout:
                size_hint_y: None
                height: "36dp"
                spacing: "8dp"

                MDCheckbox:
                    id: type_active_checkbox
                    active: True
                    size_hint: None, None
                    size: "24dp", "24dp"
                    pos_hint: {"center_y": 0.5}

                PLabel:
                    text: ((app.ui_language_code or True) and shape(tr("فعال")))
                    valign: "middle"

            BoxLayout:
                size_hint_y: None
                height: "40dp"
                spacing: "8dp"

                PRaisedButton:
                    id: type_save_button
                    text: ((app.ui_language_code or True) and shape(tr("افزودن")))
                    on_release: root.save_dimension_type()
                    focus_previous: type_code_field
                    focus_next: type_cancel_button

                PFlatButton:
                    id: type_cancel_button
                    text: ((app.ui_language_code or True) and shape(tr("لغو ویرایش (Esc)")))
                    theme_text_color: "Custom"
                    text_color: theme.TEXT_SECONDARY
                    opacity: 0
                    disabled: True
                    size_hint_y: None
                    height: "0dp"
                    on_release: root.cancel_type_edit()
                    focus_previous: type_save_button

            BoxLayout:
                id: grid_header
                size_hint_y: None
                height: "36dp"
                padding: ["10dp", "0dp"]
                canvas.before:
                    Color:
                        rgba: theme.GRID_HEADER_BG
                    Rectangle:
                        pos: self.pos
                        size: self.size
                    Color:
                        rgba: theme.GRID_BORDER
                    Line:
                        points: [self.x, self.y, self.x + self.width, self.y]
                        width: 1

                Widget:
                    size_hint_x: None
                    width: "36dp"

                PLabel:
                    text: ((app.ui_language_code or True) and shape(tr("وضعیت")))
                    font_style: "Caption"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: theme.TEXT_SECONDARY
                    halign: "right"
                    valign: "middle"
                    size_hint_x: 0.22

                PLabel:
                    text: ((app.ui_language_code or True) and shape(tr("تعداد")))
                    font_style: "Caption"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: theme.TEXT_SECONDARY
                    halign: "right"
                    valign: "middle"
                    size_hint_x: 0.18

                PLabel:
                    text: ((app.ui_language_code or True) and shape(tr("کد")))
                    font_style: "Caption"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: theme.TEXT_SECONDARY
                    valign: "middle"
                    size_hint_x: 0.6

            RecycleView:
                id: types_list
                viewclass: "DimensionTypeRowWidget"
                size_hint_y: None
                height: "200dp"
                bar_width: "8dp"
                scroll_type: ["bars", "content"]
                bar_color: theme.ACCENT
                bar_inactive_color: theme.BORDER[0], theme.BORDER[1], theme.BORDER[2], 0.6

                RecycleBoxLayout:
                    orientation: "vertical"
                    default_size_hint: 1, None
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: "0dp"

            # طبقِ درخواستِ صریح: پیکربندیِ سطح‌ها و فیلدهای اختصاصیِ گروهِ
            # انتخاب‌شده — چون تعدادِ فیلدها متغیر است و ممکن است طولانی شود،
            # این بخش در ScrollViewِ خودش (مستقل از بقیه‌ی صفحه) بالا/پایین می‌رود.
            ScrollView:
                do_scroll_x: False
                bar_width: "8dp"
                scroll_type: ["bars", "content"]
                bar_color: theme.ACCENT
                bar_inactive_color: theme.BORDER[0], theme.BORDER[1], theme.BORDER[2], 0.6

                BoxLayout:
                    id: group_config_panel
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: "10dp"
                    disabled: True
                    opacity: 0

                    PLabel:
                        text: ((app.ui_language_code or True) and shape(tr("پیکربندیِ سطح‌های کد (اختیاری، تا ۴ سطح)")))
                        font_style: "Subtitle1"
                        size_hint_y: None
                        height: self.texture_size[1]

                    PHintLabel:
                        text: ((app.ui_language_code or True) and shape(tr("طولِ کدِ هر سطح — خالی یعنی بدونِ محدودیتِ طول.")))

                    BoxLayout:
                        size_hint_y: None
                        height: "48dp"
                        spacing: "6dp"

                        PTextField:
                            id: level_4_length_field
                            hint_text: ((app.ui_language_code or True) and shape(tr("سطح ۴")))
                            persian_digits: True

                        PTextField:
                            id: level_3_length_field
                            hint_text: ((app.ui_language_code or True) and shape(tr("سطح ۳")))
                            persian_digits: True

                        PTextField:
                            id: level_2_length_field
                            hint_text: ((app.ui_language_code or True) and shape(tr("سطح ۲")))
                            persian_digits: True

                        PTextField:
                            id: level_1_length_field
                            hint_text: ((app.ui_language_code or True) and shape(tr("سطح ۱")))
                            persian_digits: True

                    PFlatButton:
                        text: ((app.ui_language_code or True) and shape(tr("ذخیره‌ی پیکربندیِ سطح‌ها")))
                        theme_text_color: "Custom"
                        text_color: theme.ACCENT
                        size_hint_y: None
                        height: "36dp"
                        on_release: root.save_group_levels()

                    PLabel:
                        text: ((app.ui_language_code or True) and shape(tr("فیلدهای اختصاصیِ این گروه")))
                        font_style: "Subtitle1"
                        size_hint_y: None
                        height: self.texture_size[1]

                    PHintLabel:
                        text: ((app.ui_language_code or True) and shape(tr("مثلاً برایِ «بانک»: شماره حساب؛ برایِ «کالا»: واحدِ سنجش.")))

                    BoxLayout:
                        id: group_fields_box
                        orientation: "vertical"
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: "4dp"

                    PFlatButton:
                        text: ((app.ui_language_code or True) and shape(tr("+ افزودنِ فیلد")))
                        theme_text_color: "Custom"
                        text_color: theme.ACCENT
                        size_hint_y: None
                        height: "36dp"
                        on_release: root.add_group_field_row()

                    PRaisedButton:
                        text: ((app.ui_language_code or True) and shape(tr("ذخیره‌ی فیلدها")))
                        size_hint_y: None
                        height: "40dp"
                        on_release: root.save_group_fields()

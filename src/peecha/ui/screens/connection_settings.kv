#:import shape peecha.ui.rtl.shape

<ConnectionSettingsScreen>:
    name: "connection_settings"
    md_bg_color: app.theme_cls.bg_normal

    MDCard:
        size_hint: None, None
        size: "420dp", "620dp"
        pos_hint: {"center_x": 0.5, "center_y": 0.5}
        orientation: "vertical"
        padding: "24dp"
        spacing: "12dp"
        elevation: 2
        radius: [12, 12, 12, 12]

        PTitleLabel:
            text: shape("تنظیمات اتصال به دیتابیس")

        PTextField:
            id: host_field
            hint_text: shape("آدرس سرور (Host)")

        PTextField:
            id: port_field
            hint_text: shape("پورت")
            input_filter: "int"

        PTextField:
            id: name_field
            hint_text: shape("نام دیتابیس")

        PTextField:
            id: user_field
            hint_text: shape("نام کاربری دیتابیس")

        PTextField:
            id: password_field
            hint_text: shape("رمز عبور دیتابیس")
            password: True

        PHintLabel:
            id: status_label
            text: ""

        BoxLayout:
            size_hint_y: None
            height: "48dp"
            spacing: "8dp"

            PFlatButton:
                text: shape("تست اتصال")
                on_release: root.test_connection_pressed()

            PFlatButton:
                text: shape("ساخت جدول‌ها")
                on_release: root.create_tables_pressed()

        BoxLayout:
            size_hint_y: None
            height: "48dp"

            Widget:

            PRaisedButton:
                text: shape("ذخیره و ادامه")
                on_release: root.save_and_continue()

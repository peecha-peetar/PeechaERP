#:import shape peecha.ui.rtl.shape
#:import theme peecha.ui.theme
#:import dp kivy.metrics.dp

# نکته‌ی مهمِ RTL: مثل بقیه‌ی صفحه‌ها — ترتیبِ اعلام در KV عمداً برعکسِ
# ترتیبِ منطقی است تا لیبلِ پیش‌فرض (که مهم‌ترین چیزِ خواندنی‌ست) راست‌ترین
# بیفتد و آیکون‌های ذخیره/بازنشانی مثلِ بقیه‌ی جدول‌ها چپ‌ترین/تریلینگ باشند.
<_FieldEditRow>:
    orientation: "horizontal"
    size_hint_y: None
    height: "56dp"
    padding: ["12dp", "4dp"]
    spacing: "8dp"
    radius: [8, 8, 8, 8]
    md_bg_color: theme.HOVER

    MDIconButton:
        id: reset_button
        icon: "restore"
        icon_size: "18sp"
        size_hint_x: None
        width: "28dp"
        theme_text_color: "Custom"
        text_color: theme.TEXT_SECONDARY
        on_release: root.reset()

    MDIconButton:
        icon: "content-save-outline"
        icon_size: "18sp"
        size_hint_x: None
        width: "28dp"
        theme_text_color: "Custom"
        text_color: theme.ACCENT
        on_release: root.save()

    PTextField:
        id: value_field
        size_hint_x: 0.5
        mode: "fill"
        on_text_validate: root.save()

    PLabel:
        text: root.default_label_text
        theme_text_color: "Custom"
        text_color: theme.TEXT_SECONDARY
        font_style: "Caption"
        valign: "middle"

<FieldLabelsScreen>:
    name: "field_labels"
    md_bg_color: theme.BACKGROUND

    BoxLayout:
        orientation: "vertical"
        padding: "24dp"
        spacing: "16dp"

        PCard:
            size_hint_y: None
            height: self.minimum_height

            PLabel:
                text: shape("عنوانِ فیلدها (چندزبانه)")
                font_style: "H5"
                size_hint_y: None
                height: self.texture_size[1]

            PHintLabel:
                text: shape("یک فرم و یک زبان انتخاب کنید؛ اگر برای زبانی عنوانی ثبت نشده باشد، عنوانِ پیش‌فرض نشان داده می‌شود.")

            BoxLayout:
                size_hint_y: None
                height: "48dp"
                spacing: "12dp"

                PSelectField:
                    id: language_button
                    text: ""
                    size_hint_x: 0.5
                    on_release: root.open_language_menu()

                PSelectField:
                    id: form_button
                    text: ""
                    size_hint_x: 0.5
                    on_release: root.open_form_menu()

            PHintLabel:
                id: status_label
                text: ""

        PCard:
            ScrollView:
                BoxLayout:
                    id: fields_list
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: "6dp"

#:import shape peecha.ui.rtl.shape
#:import tr peecha.ui.i18n.tr
#:import theme peecha.ui.theme

# نکته‌ی مهمِ RTL: مثل بقیه‌ی صفحه‌ها — ترتیبِ اعلام در KV عمداً برعکسِ
# ترتیبِ منطقی است تا فیلدِ ترجمه (مهم‌ترین چیزِ قابل‌ویرایش) راست‌ترین
# بیفتد و متنِ منبعِ فارسی (فقط‌خواندنی، کم‌رنگ‌تر) کنارش/چپ‌ترش باشد.
<_TranslationRow>:
    orientation: "horizontal"
    size_hint_y: None
    height: "56dp"
    padding: ["12dp", "4dp"]
    spacing: "8dp"
    radius: [8, 8, 8, 8]
    md_bg_color: (theme.WARNING[0], theme.WARNING[1], theme.WARNING[2], 0.1) if root.is_untranslated else theme.HOVER

    MDIconButton:
        icon: "content-save-outline"
        icon_size: "18sp"
        size_hint_x: None
        width: "28dp"
        theme_text_color: "Custom"
        text_color: theme.ACCENT
        on_release: root.save()

    PTextField:
        id: value_field
        size_hint_x: 0.5
        mode: "fill"
        on_text_validate: root.save()

    PLabel:
        text: root.source_text
        theme_text_color: "Custom"
        text_color: theme.TEXT_SECONDARY
        font_style: "Caption"
        valign: "middle"
        size_hint_x: 0.5

    MDIconButton:
        id: select_checkbox
        icon: "checkbox-marked" if root.is_checked else "checkbox-blank-outline"
        icon_size: "18sp"
        size_hint_x: None
        width: "28dp"
        theme_text_color: "Custom"
        text_color: theme.ACCENT if root.is_checked else theme.TEXT_SECONDARY
        on_release: root.toggle_checked()

<_BulkEditContent>:
    orientation: "vertical"
    size_hint_y: None
    height: "72dp"
    padding: ["8dp", "8dp"]

    PTextField:
        id: value_field
        hint_text: ((app.ui_language_code or True) and shape(tr("مقدارِ تازه برای موارد انتخاب‌شده")))
        mode: "fill"

<TranslationsScreen>:
    name: "translations"
    md_bg_color: theme.BACKGROUND

    BoxLayout:
        orientation: "vertical"
        padding: "24dp"
        spacing: "16dp"

        PCard:
            size_hint_y: None
            height: self.minimum_height

            PLabel:
                text: ((app.ui_language_code or True) and shape(tr("ترجمه‌ها")))
                font_style: "H5"
                size_hint_y: None
                height: self.texture_size[1]

            PHintLabel:
                text: ((app.ui_language_code or True) and shape(tr("متن‌های ثابتِ برنامه را برای هر زبان اینجا ببینید/اصلاح کنید؛ یا برای موارد بدون‌ترجمه از سرویسِ آنلاین کمک بگیرید.")))

            PTextField:
                id: filter_field
                size_hint_y: None
                height: "44dp"
                hint_text: ((app.ui_language_code or True) and shape(tr("جستجو در متن‌ها...")))
                mode: "fill"
                on_text: root.on_filter_text(self.text)

            BoxLayout:
                size_hint_y: None
                height: "48dp"
                spacing: "12dp"

                PSelectField:
                    id: language_button
                    text: ""
                    size_hint_x: 0.3
                    on_release: root.open_language_menu()

                PSelectField:
                    id: group_button
                    text: ""
                    size_hint_x: 0.3
                    on_release: root.open_group_menu()

                PTextField:
                    id: service_url_field
                    hint_text: ((app.ui_language_code or True) and shape(tr("آدرسِ سرویسِ ترجمه")))
                    size_hint_x: 0.4

            BoxLayout:
                size_hint_y: None
                height: "40dp"
                spacing: "12dp"

                PRaisedButton:
                    id: translate_online_button
                    text: ((app.ui_language_code or True) and shape(tr("ترجمه با سرویسِ آنلاین")))
                    on_release: root.translate_online()

                Widget:

                PRaisedButton:
                    id: bulk_delete_button
                    text: ((app.ui_language_code or True) and shape(tr("حذف")))
                    md_bg_color: theme.DANGER
                    disabled: True
                    on_release: root.bulk_delete()

                PRaisedButton:
                    id: bulk_edit_button
                    text: ((app.ui_language_code or True) and shape(tr("ویرایش")))
                    disabled: True
                    on_release: root.bulk_edit()

                PLabel:
                    text: ((app.ui_language_code or True) and shape(tr("انتخاب همه")))
                    size_hint_x: None
                    width: "90dp"
                    valign: "middle"

                MDCheckbox:
                    id: select_all_checkbox
                    size_hint: None, None
                    size: "24dp", "24dp"
                    pos_hint: {"center_y": 0.5}
                    on_active: root.toggle_select_all(self.active)

            PHintLabel:
                id: status_label
                text: ""

        PCard:
            ScrollView:
                BoxLayout:
                    id: rows_list
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: "6dp"

#:import shape peecha.ui.rtl.shape
#:import tr peecha.ui.i18n.tr
#:import theme peecha.ui.theme

# نکته‌ی مهمِ RTL: مثل بقیه‌ی صفحه‌ها — ترتیبِ اعلام در KV عمداً برعکسِ
# ترتیبِ منطقی است تا فیلدِ ترجمه (مهم‌ترین چیزِ قابل‌ویرایش) راست‌ترین
# بیفتد و متنِ منبعِ فارسی (فقط‌خواندنی، کم‌رنگ‌تر) کنارش/چپ‌ترش باشد.
<_TranslationRow>:
    orientation: "horizontal"
    size_hint_y: None
    height: "56dp"
    padding: ["12dp", "4dp"]
    spacing: "8dp"
    radius: [8, 8, 8, 8]
    md_bg_color: (theme.WARNING[0], theme.WARNING[1], theme.WARNING[2], 0.1) if root.is_untranslated else theme.HOVER

    MDIconButton:
        icon: "content-save-outline"
        icon_size: "18sp"
        size_hint_x: None
        width: "28dp"
        theme_text_color: "Custom"
        text_color: theme.ACCENT
        on_release: root.save()

    PTextField:
        id: value_field
        size_hint_x: 0.5
        mode: "fill"
        on_text_validate: root.save()

    PLabel:
        text: root.source_text
        theme_text_color: "Custom"
        text_color: theme.TEXT_SECONDARY
        font_style: "Caption"
        valign: "middle"
        size_hint_x: 0.5

<TranslationsScreen>:
    name: "translations"
    md_bg_color: theme.BACKGROUND

    BoxLayout:
        orientation: "vertical"
        padding: "24dp"
        spacing: "16dp"

        PCard:
            size_hint_y: None
            height: self.minimum_height

            PLabel:
                text: ((app.ui_language_code or True) and shape(tr("ترجمه‌ها")))
                font_style: "H5"
                size_hint_y: None
                height: self.texture_size[1]

            PHintLabel:
                text: ((app.ui_language_code or True) and shape(tr("متن‌های ثابتِ برنامه را برای هر زبان اینجا ببینید/اصلاح کنید؛ یا برای موارد بدون‌ترجمه از سرویسِ آنلاین کمک بگیرید.")))

            BoxLayout:
                size_hint_y: None
                height: "48dp"
                spacing: "12dp"

                PSelectField:
                    id: language_button
                    text: ""
                    size_hint_x: 0.3
                    on_release: root.open_language_menu()

                PTextField:
                    id: filter_field
                    hint_text: ((app.ui_language_code or True) and shape(tr("جستجو در متن‌ها...")))
                    size_hint_x: 0.4
                    on_text: root.on_filter_text(self.text)

                PTextField:
                    id: service_url_field
                    hint_text: ((app.ui_language_code or True) and shape(tr("آدرسِ سرویسِ ترجمه")))
                    size_hint_x: 0.3

            BoxLayout:
                size_hint_y: None
                height: "40dp"
                spacing: "12dp"

                Widget:

                PRaisedButton:
                    id: translate_online_button
                    text: ((app.ui_language_code or True) and shape(tr("ترجمه با سرویسِ آنلاین")))
                    on_release: root.translate_online()

            PHintLabel:
                id: status_label
                text: ""

        PCard:
            ScrollView:
                BoxLayout:
                    id: rows_list
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: "6dp"

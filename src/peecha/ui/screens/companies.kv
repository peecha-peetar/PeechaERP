#:import shape peecha.ui.rtl.shape
#:import theme peecha.ui.theme
#:import dp kivy.metrics.dp

# نکته‌ی مهمِ RTL: مثل chart_of_accounts.kv — ترتیبِ اعلام در KV عمداً
# برعکسِ ترتیب منطقیِ ستون‌هاست تا «کد» راست‌ترین بیفتد.
# حذفِ شرکت عمداً در این فرم نیست (برخلاف زبان/کاربر) چون شرکت والدِ
# داده‌های زیادی‌ست (سند حسابداری، کدینگ و ...)؛ فقط ویرایش/غیرفعال‌سازی.
<CompanyRowWidget>:
    orientation: "horizontal"
    size_hint_y: None
    height: "40dp"
    padding: ["12dp", "0dp"]
    radius: [8, 8, 8, 8]
    md_bg_color: theme.SELECTED if root.selected else (theme.HOVER if root.zebra else (0, 0, 0, 0))

    MDIconButton:
        icon: "pencil-outline"
        icon_size: "18sp"
        size_hint_x: None
        width: "28dp"
        theme_text_color: "Custom"
        text_color: theme.ACCENT
        on_release: root.on_release()

    AnchorLayout:
        size_hint_x: 0.16
        anchor_x: "right"
        anchor_y: "center"

        PBadge:
            text: root.status_text
            badge_color: theme.SUCCESS if root.is_active_row else theme.TEXT_DISABLED

    PLabel:
        text: root.language_text
        theme_text_color: "Custom"
        text_color: theme.TEXT_SECONDARY
        valign: "middle"
        size_hint_x: 0.18

    PLabel:
        text: root.currency_text
        theme_text_color: "Custom"
        text_color: theme.TEXT_SECONDARY
        valign: "middle"
        size_hint_x: 0.14

    PLabel:
        text: root.name_text
        valign: "middle"
        size_hint_x: 0.34

    PLabel:
        text: root.code_text
        theme_text_color: "Custom"
        text_color: theme.TEXT_SECONDARY
        valign: "middle"
        size_hint_x: 0.14

<CompaniesScreen>:
    name: "companies"
    md_bg_color: theme.BACKGROUND

    BoxLayout:
        orientation: "horizontal"
        padding: "24dp"
        spacing: "20dp"

        PCard:
            size_hint_x: 0.58

            PLabel:
                text: shape("شرکت‌ها")
                font_style: "H5"
                size_hint_y: None
                height: self.texture_size[1]

            PHintLabel:
                id: status_label
                text: ""

            BoxLayout:
                id: grid_header
                size_hint_y: None
                height: "32dp"
                padding: ["12dp", "0dp"]

                Widget:
                    size_hint_x: None
                    width: "28dp"

                PLabel:
                    text: shape("وضعیت")
                    font_style: "Caption"
                    theme_text_color: "Custom"
                    text_color: theme.TEXT_SECONDARY
                    halign: "right"
                    valign: "middle"
                    size_hint_x: 0.16

                PLabel:
                    text: shape("زبان")
                    font_style: "Caption"
                    theme_text_color: "Custom"
                    text_color: theme.TEXT_SECONDARY
                    valign: "middle"
                    size_hint_x: 0.18

                PLabel:
                    text: shape("ارز")
                    font_style: "Caption"
                    theme_text_color: "Custom"
                    text_color: theme.TEXT_SECONDARY
                    valign: "middle"
                    size_hint_x: 0.14

                PLabel:
                    text: shape("نام نمایشی")
                    font_style: "Caption"
                    theme_text_color: "Custom"
                    text_color: theme.TEXT_SECONDARY
                    valign: "middle"
                    size_hint_x: 0.34

                PLabel:
                    text: shape("کد")
                    font_style: "Caption"
                    theme_text_color: "Custom"
                    text_color: theme.TEXT_SECONDARY
                    valign: "middle"
                    size_hint_x: 0.14

            ScrollView:
                BoxLayout:
                    id: companies_list
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: "2dp"

        PCard:
            size_hint_x: 0.42
            spacing: "12dp"

            ScrollView:
                do_scroll_x: False

                BoxLayout:
                    orientation: "vertical"
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: "12dp"

                    PLabel:
                        id: form_title
                        text: shape("افزودن شرکت جدید")
                        font_style: "Subtitle1"
                        size_hint_y: None
                        height: self.texture_size[1]

                    PTextField:
                        id: code_field
                        hint_text: shape("کد شرکت")
                        focus_next: legal_name_field

                    PTextField:
                        id: legal_name_field
                        hint_text: shape("نام حقوقی")
                        focus_next: display_name_field
                        focus_previous: code_field

                    PTextField:
                        id: display_name_field
                        hint_text: shape("نام نمایشی")
                        focus_next: economic_code_field
                        focus_previous: legal_name_field

                    PTextField:
                        id: economic_code_field
                        hint_text: shape("کد اقتصادی")
                        persian_digits: True
                        focus_next: registration_no_field
                        focus_previous: display_name_field

                    PTextField:
                        id: registration_no_field
                        hint_text: shape("شماره ثبت")
                        persian_digits: True
                        focus_next: national_id_field
                        focus_previous: economic_code_field

                    PTextField:
                        id: national_id_field
                        hint_text: shape("شناسه ملی")
                        persian_digits: True
                        focus_next: fy_start_day_field
                        focus_previous: registration_no_field

                    BoxLayout:
                        size_hint_y: None
                        height: "48dp"
                        spacing: "12dp"

                        PTextField:
                            id: fy_start_day_field
                            hint_text: shape("روزِ شروعِ سال مالی")
                            text: "۱"
                            persian_digits: True
                            size_hint_x: 0.5
                            focus_next: fy_start_month_field
                            focus_previous: national_id_field

                        PTextField:
                            id: fy_start_month_field
                            hint_text: shape("ماهِ شروعِ سال مالی")
                            text: "۱"
                            persian_digits: True
                            size_hint_x: 0.5
                            focus_next: currency_button
                            focus_previous: fy_start_day_field

                    PSelectField:
                        id: currency_button
                        text: ""
                        on_release: root.open_currency_menu()
                        focus_next: language_button

                    PSelectField:
                        id: language_button
                        text: ""
                        on_release: root.open_language_menu()
                        focus_next: save_button

                    BoxLayout:
                        size_hint_y: None
                        height: "36dp"
                        spacing: "8dp"

                        MDCheckbox:
                            id: is_active_checkbox
                            active: True
                            size_hint: None, None
                            size: "24dp", "24dp"
                            pos_hint: {"center_y": 0.5}

                        PLabel:
                            text: shape("فعال")
                            valign: "middle"

                    PRaisedButton:
                        id: save_button
                        text: shape("افزودن شرکت")
                        on_release: root.save_company()
                        focus_previous: language_button
                        focus_next: cancel_edit_button

                    PFlatButton:
                        id: cancel_edit_button
                        text: shape("لغو ویرایش (Esc)")
                        theme_text_color: "Custom"
                        text_color: theme.TEXT_SECONDARY
                        opacity: 0
                        disabled: True
                        size_hint_y: None
                        height: "0dp"
                        on_release: root.cancel_edit()
                        focus_previous: save_button

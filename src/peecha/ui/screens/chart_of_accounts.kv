#:import shape peecha.ui.rtl.shape
#:import tr peecha.ui.i18n.tr
#:import theme peecha.ui.theme
#:import dp kivy.metrics.dp

# ردیفِ جدولِ کدینگ حسابداری — چهار ستون: کد | نام حساب | سطح | وضعیت +
# دو آیکونِ ویرایش/حذف. عرضِ ستون‌های نسبی اینجا و در هدر (پایین‌تر در
# <ChartOfAccountsScreen>) باید دقیقاً یکی باشد وگرنه ستون‌های ردیف زیر
# هدر نمی‌نشینند.
#
# نکته‌ی مهمِ RTL: چون در BoxLayout افقیِ Kivy فرزندِ اول‌اعلام‌شده همیشه
# چپ‌ترین می‌شود (تست مستقیم تایید کرد)، برای این‌که «کد» (اولین ستونِ
# منطقی از راست) واقعاً راست‌ترین بیفتد، باید در KV آخر از همه اعلام شود؛
# ترتیب اینجا عمداً برعکسِ ترتیب منطقیِ ستون‌هاست.
<AccountRowWidget>:
    orientation: "horizontal"
    size_hint_y: None
    height: "32dp"
    padding: ["12dp", "0dp"]
    radius: [8, 8, 8, 8]
    md_bg_color: theme.SELECTED if root.selected else (theme.HOVER if root.zebra else (0, 0, 0, 0))

    MDIconButton:
        icon: "trash-can-outline"
        icon_size: "18sp"
        size_hint_x: None
        width: "28dp"
        theme_text_color: "Custom"
        text_color: theme.DANGER
        on_release: root.request_delete()

    MDIconButton:
        icon: "pencil-outline"
        icon_size: "18sp"
        size_hint_x: None
        width: "28dp"
        theme_text_color: "Custom"
        text_color: theme.ACCENT
        on_release: root.on_release()

    AnchorLayout:
        size_hint_x: 0.20
        anchor_x: "right"
        anchor_y: "center"

        PBadge:
            text: root.status_text
            badge_color: root.status_badge_color

    AnchorLayout:
        size_hint_x: 0.15
        anchor_x: "right"
        anchor_y: "center"

        PBadge:
            text: root.level_text
            badge_color: root.level_badge_color

    PLabel:
        text: root.name_text
        valign: "middle"
        size_hint_x: 0.43

    PLabel:
        text: root.code_text
        theme_text_color: "Custom"
        text_color: theme.TEXT_SECONDARY
        valign: "middle"
        size_hint_x: 0.22

<ChartOfAccountsScreen>:
    name: "chart_of_accounts"
    md_bg_color: theme.BACKGROUND

    BoxLayout:
        orientation: "horizontal"
        padding: "24dp"
        spacing: "20dp"

        PCard:
            size_hint_x: 0.62

            PLabel:
                text: ((app.ui_language_code or True) and shape(tr("کدینگ حسابداری (گروه / کل / معین)")))
                font_style: "H5"
                size_hint_y: None
                height: self.texture_size[1]

            PHintLabel:
                id: status_label
                text: ""

            # هدرِ ستون‌ها بیرون از ScrollView (چسبان/sticky، طبق
            # docs/ui-ux-guidelines.md بخش ۷): با اسکرول ردیف‌ها جابه‌جا نمی‌شود.
            # ترتیبِ ستون‌ها هم مثلِ <AccountRowWidget> عمداً برعکس است (توضیح بالا).
            BoxLayout:
                id: grid_header
                size_hint_y: None
                height: "32dp"
                padding: ["12dp", "0dp"]

                Widget:
                    size_hint_x: None
                    width: "56dp"

                PLabel:
                    text: ((app.ui_language_code or True) and shape(tr("وضعیت")))
                    font_style: "Caption"
                    theme_text_color: "Custom"
                    text_color: theme.TEXT_SECONDARY
                    halign: "right"
                    valign: "middle"
                    size_hint_x: 0.20

                PLabel:
                    text: ((app.ui_language_code or True) and shape(tr("سطح")))
                    font_style: "Caption"
                    theme_text_color: "Custom"
                    text_color: theme.TEXT_SECONDARY
                    halign: "right"
                    valign: "middle"
                    size_hint_x: 0.15

                PLabel:
                    text: ((app.ui_language_code or True) and shape(tr("نام حساب")))
                    font_style: "Caption"
                    theme_text_color: "Custom"
                    text_color: theme.TEXT_SECONDARY
                    valign: "middle"
                    size_hint_x: 0.43

                PLabel:
                    text: ((app.ui_language_code or True) and shape(tr("کد")))
                    font_style: "Caption"
                    theme_text_color: "Custom"
                    text_color: theme.TEXT_SECONDARY
                    valign: "middle"
                    size_hint_x: 0.22

            RecycleView:
                id: accounts_list
                viewclass: "AccountRowWidget"

                RecycleBoxLayout:
                    orientation: "vertical"
                    default_size_hint: 1, None
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: "2dp"

        PCard:
            size_hint_x: 0.38
            spacing: "14dp"

            PLabel:
                id: form_title
                text: ((app.ui_language_code or True) and shape(tr("افزودن حساب جدید")))
                font_style: "Subtitle1"
                size_hint_y: None
                height: self.texture_size[1]

            PSelectField:
                id: parent_button
                text: ""
                on_release: root.open_parent_menu()
                focus_next: segment_code_field

            PHintLabel:
                id: level_preview_label
                text: ((app.ui_language_code or True) and shape(tr("سطحِ حساب جدید: گروه")))

            PTextField:
                id: segment_code_field
                hint_text: ((app.ui_language_code or True) and shape(tr("کد حساب (فقط بخش این سطح)")))
                persian_digits: True
                focus_next: name_field
                focus_previous: parent_button

            PTextField:
                id: name_field
                hint_text: ((app.ui_language_code or True) and shape(tr("نام حساب")))
                focus_next: nature_button
                focus_previous: segment_code_field
                on_text_validate: root.save_account()

            PSelectField:
                id: nature_button
                text: ""
                on_release: root.open_nature_menu()
                focus_next: category_button
                focus_previous: name_field

            PSelectField:
                id: category_button
                text: ""
                on_release: root.open_category_menu()
                focus_next: account_type_button
                focus_previous: nature_button

            PSelectField:
                id: account_type_button
                text: ""
                on_release: root.open_account_type_menu()
                focus_previous: category_button
                focus_next: save_button

            BoxLayout:
                size_hint_y: None
                height: "36dp"
                spacing: "8dp"

                MDCheckbox:
                    id: is_postable_checkbox
                    size_hint: None, None
                    size: "24dp", "24dp"
                    pos_hint: {"center_y": 0.5}

                PLabel:
                    text: ((app.ui_language_code or True) and shape(tr("قابل ثبت سند (Postable)")))
                    valign: "middle"

            Widget:

            PRaisedButton:
                id: save_button
                text: ((app.ui_language_code or True) and shape(tr("افزودن حساب")))
                on_release: root.save_account()
                focus_previous: account_type_button
                focus_next: cancel_edit_button

            PFlatButton:
                id: cancel_edit_button
                text: ((app.ui_language_code or True) and shape(tr("لغو ویرایش (Esc)")))
                theme_text_color: "Custom"
                text_color: theme.TEXT_SECONDARY
                opacity: 0
                disabled: True
                size_hint_y: None
                height: "0dp"
                on_release: root.cancel_edit()
                focus_previous: save_button

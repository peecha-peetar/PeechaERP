#:import shape peecha.ui.rtl.shape
#:import theme peecha.ui.theme
#:import dp kivy.metrics.dp

# ردیفِ جدولِ کدینگ حسابداری — چهار ستون: کد | نام حساب | سطح | وضعیت.
# عرض ستون‌ها اینجا و در هدر (پایین‌تر در <ChartOfAccountsScreen>) باید
# دقیقاً یکی باشد وگرنه ستون‌های ردیف زیر هدر نمی‌نشینند.
<AccountRowWidget>:
    orientation: "horizontal"
    size_hint_y: None
    height: "40dp"
    padding: ["12dp", "0dp"]
    radius: [8, 8, 8, 8]
    md_bg_color: theme.HOVER if root.zebra else (0, 0, 0, 0)

    PLabel:
        text: root.code_text
        theme_text_color: "Custom"
        text_color: theme.TEXT_SECONDARY
        valign: "middle"
        size_hint_x: 0.22

    PLabel:
        text: root.name_text
        valign: "middle"
        size_hint_x: 0.43

    AnchorLayout:
        size_hint_x: 0.15
        anchor_x: "right"
        anchor_y: "center"

        PBadge:
            text: root.level_text
            badge_color: root.level_badge_color

    AnchorLayout:
        size_hint_x: 0.20
        anchor_x: "right"
        anchor_y: "center"

        PBadge:
            text: root.status_text
            badge_color: root.status_badge_color

<ChartOfAccountsScreen>:
    name: "chart_of_accounts"
    md_bg_color: theme.BACKGROUND

    BoxLayout:
        orientation: "vertical"

        BoxLayout:
            size_hint_y: None
            height: "64dp"
            padding: ["24dp", "14dp"]
            canvas.before:
                Color:
                    rgba: theme.SURFACE
                Rectangle:
                    pos: self.pos
                    size: self.size
                Color:
                    rgba: theme.DIVIDER
                Line:
                    points: [self.x, self.y, self.x + self.width, self.y]
                    width: 1

            MDBoxLayout:
                size_hint: None, None
                size: self.minimum_width, dp(36)
                padding: "4dp"
                spacing: "4dp"
                radius: [20, 20, 20, 20]
                md_bg_color: theme.HOVER

                PTabButton:
                    text: shape("کدینگ حسابداری")
                    active: True

                PTabButton:
                    text: shape("صدور سند")
                    active: False
                    on_release: root.go_to_journal_entry()

            Widget:

        BoxLayout:
            orientation: "horizontal"
            padding: "24dp"
            spacing: "20dp"

            PCard:
                size_hint_x: 0.62

                PLabel:
                    text: shape("کدینگ حسابداری (گروه / کل / معین)")
                    font_style: "H5"
                    size_hint_y: None
                    height: self.texture_size[1]

                PHintLabel:
                    id: status_label
                    text: ""

                # هدرِ ستون‌ها بیرون از ScrollView (چسبان/sticky، طبق
                # docs/ui-ux-guidelines.md بخش ۷): با اسکرول ردیف‌ها جابه‌جا نمی‌شود.
                BoxLayout:
                    id: grid_header
                    size_hint_y: None
                    height: "32dp"
                    padding: ["12dp", "0dp"]

                    PLabel:
                        text: shape("کد")
                        font_style: "Caption"
                        theme_text_color: "Custom"
                        text_color: theme.TEXT_SECONDARY
                        valign: "middle"
                        size_hint_x: 0.22

                    PLabel:
                        text: shape("نام حساب")
                        font_style: "Caption"
                        theme_text_color: "Custom"
                        text_color: theme.TEXT_SECONDARY
                        valign: "middle"
                        size_hint_x: 0.43

                    PLabel:
                        text: shape("سطح")
                        font_style: "Caption"
                        theme_text_color: "Custom"
                        text_color: theme.TEXT_SECONDARY
                        halign: "right"
                        valign: "middle"
                        size_hint_x: 0.15

                    PLabel:
                        text: shape("وضعیت")
                        font_style: "Caption"
                        theme_text_color: "Custom"
                        text_color: theme.TEXT_SECONDARY
                        halign: "right"
                        valign: "middle"
                        size_hint_x: 0.20

                ScrollView:
                    BoxLayout:
                        id: accounts_list
                        orientation: "vertical"
                        size_hint_y: None
                        height: self.minimum_height
                        spacing: "2dp"

            PCard:
                size_hint_x: 0.38
                spacing: "14dp"

                PLabel:
                    text: shape("افزودن حساب جدید")
                    font_style: "Subtitle1"
                    size_hint_y: None
                    height: self.texture_size[1]

                PSelectField:
                    id: parent_button
                    text: ""
                    on_release: root.open_parent_menu()

                PHintLabel:
                    id: level_preview_label
                    text: shape("سطحِ حساب جدید: گروه")

                PTextField:
                    id: segment_code_field
                    hint_text: shape("کد حساب (فقط بخش این سطح)")

                PTextField:
                    id: name_field
                    hint_text: shape("نام حساب")

                PSelectField:
                    id: nature_button
                    text: ""
                    on_release: root.open_nature_menu()

                PSelectField:
                    id: category_button
                    text: ""
                    on_release: root.open_category_menu()

                PSelectField:
                    id: account_type_button
                    text: ""
                    on_release: root.open_account_type_menu()

                BoxLayout:
                    size_hint_y: None
                    height: "36dp"
                    spacing: "8dp"

                    MDCheckbox:
                        id: is_postable_checkbox
                        size_hint: None, None
                        size: "24dp", "24dp"
                        pos_hint: {"center_y": 0.5}

                    PLabel:
                        text: shape("قابل ثبت سند (Postable)")
                        valign: "middle"

                Widget:

                PRaisedButton:
                    text: shape("افزودن حساب")
                    on_release: root.add_account()

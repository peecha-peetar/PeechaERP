#:import shape peecha.ui.rtl.shape
#:import tr peecha.ui.i18n.tr
#:import theme peecha.ui.theme
#:import dp kivy.metrics.dp

<AdminBootstrapScreen>:
    name: "admin_bootstrap"
    md_bg_color: theme.BACKGROUND

    ScrollView:
        BoxLayout:
            orientation: "vertical"
            size_hint: None, None
            size: dp(380), self.minimum_height
            pos_hint: {"center_x": 0.5}
            padding: ["0dp", "32dp"]
            spacing: "20dp"

            MDBoxLayout:
                size_hint: None, None
                size: "64dp", "64dp"
                pos_hint: {"center_x": 0.5}
                radius: [22, 22, 22, 22]
                md_bg_color: theme.PRIMARY

                MDIcon:
                    icon: "chart-donut"
                    theme_text_color: "Custom"
                    text_color: 1, 1, 1, 1
                    halign: "center"
                    valign: "middle"
                    font_size: "30sp"

            PCard:
                size_hint_y: None
                height: self.minimum_height

                PTitleLabel:
                    text: ((app.ui_language_code or True) and shape(tr("راه‌اندازی اولیه‌ی پیچا")))

                PLabel:
                    text: ((app.ui_language_code or True) and shape(tr("هنوز هیچ کاربری در سیستم ثبت نشده؛ این کاربر و شرکت، اولین‌ها خواهند بود.")))
                    theme_text_color: "Hint"
                    size_hint_y: None
                    height: self.texture_size[1]

                PTextField:
                    id: company_name_field
                    hint_text: ((app.ui_language_code or True) and shape(tr("نام شرکت")))
                    focus_next: username_field
                    on_text_validate: root.create_admin()

                PTextField:
                    id: username_field
                    hint_text: ((app.ui_language_code or True) and shape(tr("نام کاربری مدیر")))
                    focus_next: full_name_field
                    focus_previous: company_name_field
                    on_text_validate: root.create_admin()

                PTextField:
                    id: full_name_field
                    hint_text: ((app.ui_language_code or True) and shape(tr("نام کامل مدیر")))
                    focus_next: password_field
                    focus_previous: username_field
                    on_text_validate: root.create_admin()

                PTextField:
                    id: password_field
                    hint_text: ((app.ui_language_code or True) and shape(tr("رمز عبور")))
                    password: True
                    focus_next: confirm_password_field
                    focus_previous: full_name_field
                    on_text_validate: root.create_admin()

                PTextField:
                    id: confirm_password_field
                    hint_text: ((app.ui_language_code or True) and shape(tr("تکرار رمز عبور")))
                    password: True
                    focus_previous: password_field
                    on_text_validate: root.create_admin()

                PHintLabel:
                    id: status_label
                    text: ""

                PRaisedButton:
                    text: ((app.ui_language_code or True) and shape(tr("ساخت و ورود")))
                    pos_hint: {"center_x": 0.5}
                    on_release: root.create_admin()

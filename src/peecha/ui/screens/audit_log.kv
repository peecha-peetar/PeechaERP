#:import shape peecha.ui.rtl.shape
#:import tr peecha.ui.i18n.tr
#:import theme peecha.ui.theme
#:import dp kivy.metrics.dp

# نکته‌ی مهمِ RTL: ترتیبِ اعلام عمداً برعکسِ ترتیبِ منطقیِ ستون‌هاست تا
# «تاریخ» (اولین چیزِ منطقی از راست) راست‌ترین بیفتد.
<AuditLogRowWidget>:
    orientation: "horizontal"
    size_hint_y: None
    height: "36dp"
    padding: ["10dp", "0dp"]
    md_bg_color: theme.GRID_ROW_ALT if root.zebra else theme.SURFACE
    canvas.after:
        Color:
            rgba: theme.GRID_BORDER
        Line:
            points: [self.x, self.y, self.x + self.width, self.y]
            width: 1

    MDIconButton:
        icon: "information-outline"
        icon_size: "12sp"
        size_hint_x: None
        width: "36dp"
        theme_text_color: "Custom"
        text_color: theme.ACCENT
        on_release: root.on_release()

    AnchorLayout:
        size_hint_x: 0.14
        anchor_x: "right"
        anchor_y: "center"

        PBadge:
            text: root.action_text
            badge_color: root.action_badge_color

    PLabel:
        text: root.entity_id_text
        theme_text_color: "Custom"
        text_color: theme.TEXT_SECONDARY
        halign: "right"
        valign: "middle"
        size_hint_x: 0.1

    PLabel:
        text: root.entity_text
        valign: "middle"
        size_hint_x: 0.22

    PLabel:
        text: root.user_text
        theme_text_color: "Custom"
        text_color: theme.TEXT_SECONDARY
        valign: "middle"
        size_hint_x: 0.24

    PLabel:
        text: root.date_text
        valign: "middle"
        size_hint_x: 0.3

<AuditLogScreen>:
    name: "audit_log"
    md_bg_color: theme.BACKGROUND

    BoxLayout:
        orientation: "vertical"
        padding: "24dp"
        spacing: "16dp"

        PCard:
            size_hint_y: None
            height: self.minimum_height

            PLabel:
                text: ((app.ui_language_code or True) and shape(tr("ردِ حسابرسی")))
                font_style: "H5"
                size_hint_y: None
                height: self.texture_size[1]

            PHintLabel:
                text: ((app.ui_language_code or True) and shape(tr("رویدادهای ایجاد/ویرایش/حذفِ اطلاعاتِ کسب‌وکاری — فقط‌خواندنی و تغییرناپذیر.")))

            BoxLayout:
                size_hint_y: None
                height: "48dp"
                spacing: "12dp"

                PSelectField:
                    id: type_button
                    text: ""
                    size_hint_x: 0.3
                    on_release: root.open_type_menu()

                Widget:

            PHintLabel:
                id: status_label
                text: ""

        PCard:
            BoxLayout:
                id: grid_header
                size_hint_y: None
                height: "36dp"
                padding: ["10dp", "0dp"]
                canvas.before:
                    Color:
                        rgba: theme.GRID_HEADER_BG
                    Rectangle:
                        pos: self.pos
                        size: self.size
                    Color:
                        rgba: theme.GRID_BORDER
                    Line:
                        points: [self.x, self.y, self.x + self.width, self.y]
                        width: 1

                Widget:
                    size_hint_x: None
                    width: "36dp"

                PLabel:
                    text: ((app.ui_language_code or True) and shape(tr("عملیات")))
                    font_style: "Caption"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: theme.TEXT_SECONDARY
                    halign: "right"
                    valign: "middle"
                    size_hint_x: 0.14

                PLabel:
                    text: ((app.ui_language_code or True) and shape(tr("شناسه")))
                    font_style: "Caption"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: theme.TEXT_SECONDARY
                    halign: "right"
                    valign: "middle"
                    size_hint_x: 0.1

                PLabel:
                    text: ((app.ui_language_code or True) and shape(tr("نوعِ موجودیت")))
                    font_style: "Caption"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: theme.TEXT_SECONDARY
                    valign: "middle"
                    size_hint_x: 0.22

                PLabel:
                    text: ((app.ui_language_code or True) and shape(tr("کاربر")))
                    font_style: "Caption"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: theme.TEXT_SECONDARY
                    valign: "middle"
                    size_hint_x: 0.24

                PLabel:
                    text: ((app.ui_language_code or True) and shape(tr("تاریخ/ساعت")))
                    font_style: "Caption"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: theme.TEXT_SECONDARY
                    valign: "middle"
                    size_hint_x: 0.3

            RecycleView:
                id: log_list
                viewclass: "AuditLogRowWidget"
                bar_width: "8dp"
                scroll_type: ["bars", "content"]
                bar_color: theme.ACCENT
                bar_inactive_color: theme.BORDER[0], theme.BORDER[1], theme.BORDER[2], 0.6

                RecycleBoxLayout:
                    orientation: "vertical"
                    default_size_hint: 1, None
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: "0dp"

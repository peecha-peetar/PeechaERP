#:import shape peecha.ui.rtl.shape
#:import tr peecha.ui.i18n.tr
#:import theme peecha.ui.theme
#:import dp kivy.metrics.dp

# نکته‌ی مهمِ RTL: ترتیبِ اعلام عمداً برعکسِ ترتیبِ منطقیِ ستون‌هاست تا
# «تاریخ» (اولین چیزِ منطقی از راست) راست‌ترین بیفتد.
<AuditLogRowWidget>:
    orientation: "horizontal"
    size_hint_y: None
    height: "32dp"
    padding: ["12dp", "0dp"]
    radius: [8, 8, 8, 8]
    md_bg_color: theme.HOVER if root.zebra else (0, 0, 0, 0)

    MDIconButton:
        icon: "information-outline"
        icon_size: "18sp"
        size_hint_x: None
        width: "28dp"
        theme_text_color: "Custom"
        text_color: theme.ACCENT
        on_release: root.on_release()

    AnchorLayout:
        size_hint_x: 0.14
        anchor_x: "right"
        anchor_y: "center"

        PBadge:
            text: root.action_text
            badge_color: root.action_badge_color

    PLabel:
        text: root.entity_id_text
        theme_text_color: "Custom"
        text_color: theme.TEXT_SECONDARY
        halign: "right"
        valign: "middle"
        size_hint_x: 0.1

    PLabel:
        text: root.entity_text
        valign: "middle"
        size_hint_x: 0.22

    PLabel:
        text: root.user_text
        theme_text_color: "Custom"
        text_color: theme.TEXT_SECONDARY
        valign: "middle"
        size_hint_x: 0.24

    PLabel:
        text: root.date_text
        valign: "middle"
        size_hint_x: 0.3

<AuditLogScreen>:
    name: "audit_log"
    md_bg_color: theme.BACKGROUND

    BoxLayout:
        orientation: "vertical"
        padding: "24dp"
        spacing: "16dp"

        PCard:
            size_hint_y: None
            height: self.minimum_height

            PLabel:
                text: ((app.ui_language_code or True) and shape(tr("ردِ حسابرسی")))
                font_style: "H5"
                size_hint_y: None
                height: self.texture_size[1]

            PHintLabel:
                text: ((app.ui_language_code or True) and shape(tr("رویدادهای ایجاد/ویرایش/حذفِ اطلاعاتِ کسب‌وکاری — فقط‌خواندنی و تغییرناپذیر.")))

            BoxLayout:
                size_hint_y: None
                height: "48dp"
                spacing: "12dp"

                PSelectField:
                    id: type_button
                    text: ""
                    size_hint_x: 0.3
                    on_release: root.open_type_menu()

                Widget:

            PHintLabel:
                id: status_label
                text: ""

        PCard:
            BoxLayout:
                id: grid_header
                size_hint_y: None
                height: "32dp"
                padding: ["12dp", "0dp"]

                Widget:
                    size_hint_x: None
                    width: "28dp"

                PLabel:
                    text: ((app.ui_language_code or True) and shape(tr("عملیات")))
                    font_style: "Caption"
                    theme_text_color: "Custom"
                    text_color: theme.TEXT_SECONDARY
                    halign: "right"
                    valign: "middle"
                    size_hint_x: 0.14

                PLabel:
                    text: ((app.ui_language_code or True) and shape(tr("شناسه")))
                    font_style: "Caption"
                    theme_text_color: "Custom"
                    text_color: theme.TEXT_SECONDARY
                    halign: "right"
                    valign: "middle"
                    size_hint_x: 0.1

                PLabel:
                    text: ((app.ui_language_code or True) and shape(tr("نوعِ موجودیت")))
                    font_style: "Caption"
                    theme_text_color: "Custom"
                    text_color: theme.TEXT_SECONDARY
                    valign: "middle"
                    size_hint_x: 0.22

                PLabel:
                    text: ((app.ui_language_code or True) and shape(tr("کاربر")))
                    font_style: "Caption"
                    theme_text_color: "Custom"
                    text_color: theme.TEXT_SECONDARY
                    valign: "middle"
                    size_hint_x: 0.24

                PLabel:
                    text: ((app.ui_language_code or True) and shape(tr("تاریخ/ساعت")))
                    font_style: "Caption"
                    theme_text_color: "Custom"
                    text_color: theme.TEXT_SECONDARY
                    valign: "middle"
                    size_hint_x: 0.3

            RecycleView:
                id: log_list
                viewclass: "AuditLogRowWidget"

                RecycleBoxLayout:
                    orientation: "vertical"
                    default_size_hint: 1, None
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: "2dp"

#:import shape peecha.ui.rtl.shape
#:import tr peecha.ui.i18n.tr
#:import theme peecha.ui.theme
#:import dp kivy.metrics.dp

# ردیفِ جدولِ اسناد — شماره | تاریخ | شرح | مبلغ | وضعیت + ویرایش/حذف
# (ترتیبِ منطقی، از راست). فقط سندهای TEMPORARY/DRAFT قابل‌ویرایش/حذف‌اند
# (root.editable)؛ برای بقیه این دو آیکون اصلاً نمایش داده نمی‌شوند و کلیکِ
# ردیف هم اثری ندارد.
<JournalEntryRowWidget>:
    orientation: "horizontal"
    size_hint_y: None
    height: "36dp"
    padding: ["10dp", "0dp"]
    md_bg_color: theme.GRID_ROW_ALT if root.zebra else theme.SURFACE
    canvas.after:
        Color:
            rgba: theme.GRID_BORDER
        Line:
            points: [self.x, self.y, self.x + self.width, self.y]
            width: 1

    MDIconButton:
        icon: "trash-can-outline"
        icon_size: "12sp"
        size_hint_x: None
        width: "36dp"
        opacity: 1 if root.editable else 0
        disabled: not root.editable
        theme_text_color: "Custom"
        text_color: theme.DANGER
        on_release: root.request_delete()

    MDIconButton:
        icon: "pencil-outline"
        icon_size: "12sp"
        size_hint_x: None
        width: "36dp"
        opacity: 1 if root.editable else 0
        disabled: not root.editable
        theme_text_color: "Custom"
        text_color: theme.ACCENT
        on_release: root.on_release()

    AnchorLayout:
        size_hint_x: 0.16
        anchor_x: "right"
        anchor_y: "center"

        PBadge:
            text: root.status_text
            badge_color: root.status_badge_color

    PLabel:
        text: root.amount_text
        valign: "middle"
        halign: "right"
        size_hint_x: 0.16

    PLabel:
        text: root.description_text
        valign: "middle"
        size_hint_x: 0.34

    PLabel:
        text: root.date_text
        theme_text_color: "Custom"
        text_color: theme.TEXT_SECONDARY
        valign: "middle"
        size_hint_x: 0.16

    PLabel:
        text: root.number_text
        theme_text_color: "Custom"
        text_color: theme.TEXT_SECONDARY
        valign: "middle"
        size_hint_x: 0.10


<JournalEntriesListScreen>:
    name: "journal_entries_list"
    md_bg_color: theme.BACKGROUND

    BoxLayout:
        orientation: "vertical"
        padding: "24dp"
        spacing: "16dp"

        PCard:
            size_hint_y: None
            height: self.minimum_height

            BoxLayout:
                size_hint_y: None
                height: self.minimum_height
                spacing: "12dp"

                PLabel:
                    text: ((app.ui_language_code or True) and shape(tr("اسناد حسابداری")))
                    font_style: "H5"
                    size_hint_y: None
                    height: self.texture_size[1]

                Widget:

                PRaisedButton:
                    text: ((app.ui_language_code or True) and shape(tr("+ سند جدید")))
                    size_hint_x: None
                    width: "140dp"
                    on_release: root.open_new_entry()

            BoxLayout:
                size_hint_y: None
                height: "48dp"
                spacing: "12dp"

                PTextField:
                    id: search_field
                    hint_text: ((app.ui_language_code or True) and shape(tr("جستجو در شماره سند، شرح یا شماره عطف")))
                    size_hint_x: 0.5
                    on_text: root.filter_entries()

                Widget:

            PHintLabel:
                id: status_label
                text: ""

        PCard:
            BoxLayout:
                id: grid_header
                size_hint_y: None
                height: "36dp"
                padding: ["10dp", "0dp"]
                canvas.before:
                    Color:
                        rgba: theme.GRID_HEADER_BG
                    Rectangle:
                        pos: self.pos
                        size: self.size
                    Color:
                        rgba: theme.GRID_BORDER
                    Line:
                        points: [self.x, self.y, self.x + self.width, self.y]
                        width: 1

                Widget:
                    size_hint_x: None
                    width: "72dp"

                PLabel:
                    text: ((app.ui_language_code or True) and shape(tr("وضعیت")))
                    font_style: "Caption"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: theme.TEXT_SECONDARY
                    halign: "right"
                    valign: "middle"
                    size_hint_x: 0.16

                PLabel:
                    text: ((app.ui_language_code or True) and shape(tr("مبلغ")))
                    font_style: "Caption"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: theme.TEXT_SECONDARY
                    halign: "right"
                    valign: "middle"
                    size_hint_x: 0.16

                PLabel:
                    text: ((app.ui_language_code or True) and shape(tr("شرح")))
                    font_style: "Caption"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: theme.TEXT_SECONDARY
                    valign: "middle"
                    size_hint_x: 0.34

                PLabel:
                    text: ((app.ui_language_code or True) and shape(tr("تاریخ")))
                    font_style: "Caption"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: theme.TEXT_SECONDARY
                    valign: "middle"
                    size_hint_x: 0.16

                PLabel:
                    text: ((app.ui_language_code or True) and shape(tr("شماره")))
                    font_style: "Caption"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: theme.TEXT_SECONDARY
                    valign: "middle"
                    size_hint_x: 0.10

            RecycleView:
                id: entries_list
                viewclass: "JournalEntryRowWidget"
                bar_width: "8dp"
                scroll_type: ["bars", "content"]
                bar_color: theme.ACCENT
                bar_inactive_color: theme.BORDER[0], theme.BORDER[1], theme.BORDER[2], 0.6

                RecycleBoxLayout:
                    orientation: "vertical"
                    default_size_hint: 1, None
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: "0dp"

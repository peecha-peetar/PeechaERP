#:import shape peecha.ui.rtl.shape
#:import tr peecha.ui.i18n.tr
#:import theme peecha.ui.theme
#:import dp kivy.metrics.dp

# نکته‌ی مهمِ RTL: مثل بقیه‌ی صفحه‌ها — ترتیبِ اعلام در KV عمداً برعکسِ
# ترتیب منطقیِ ستون‌هاست تا «کد» راست‌ترین بیفتد.
<FiscalYearRowWidget>:
    orientation: "horizontal"
    size_hint_y: None
    height: "36dp"
    padding: ["10dp", "0dp"]
    md_bg_color: theme.GRID_ROW_ALT if root.zebra else theme.SURFACE
    canvas.after:
        Color:
            rgba: theme.GRID_BORDER
        Line:
            points: [self.x, self.y, self.x + self.width, self.y]
            width: 1

    MDIconButton:
        icon: "lock-open-variant-outline" if root.is_closed_row else "lock-outline"
        icon_size: "12sp"
        size_hint_x: None
        width: "36dp"
        theme_text_color: "Custom"
        text_color: theme.ACCENT if root.is_closed_row else theme.TEXT_SECONDARY
        on_release: root.toggle()

    AnchorLayout:
        size_hint_x: 0.14
        anchor_x: "right"
        anchor_y: "center"

        PBadge:
            text: root.status_text
            badge_color: theme.TEXT_DISABLED if root.is_closed_row else theme.SUCCESS

    PLabel:
        text: root.periods_text
        theme_text_color: "Custom"
        text_color: theme.TEXT_SECONDARY
        valign: "middle"
        size_hint_x: 0.18

    PLabel:
        text: root.range_text
        valign: "middle"
        size_hint_x: 0.5

    PLabel:
        text: root.code_text
        theme_text_color: "Custom"
        text_color: theme.TEXT_SECONDARY
        valign: "middle"
        size_hint_x: 0.18

<FiscalYearsScreen>:
    name: "fiscal_years"
    md_bg_color: theme.BACKGROUND

    BoxLayout:
        orientation: "horizontal"
        padding: "24dp"
        spacing: "20dp"

        PCard:
            size_hint_x: 0.66

            PLabel:
                text: ((app.ui_language_code or True) and shape(tr("سال‌های مالی")))
                font_style: "H5"
                size_hint_y: None
                height: self.texture_size[1]

            BoxLayout:
                id: grid_header
                size_hint_y: None
                height: "36dp"
                padding: ["10dp", "0dp"]
                canvas.before:
                    Color:
                        rgba: theme.GRID_HEADER_BG
                    Rectangle:
                        pos: self.pos
                        size: self.size
                    Color:
                        rgba: theme.GRID_BORDER
                    Line:
                        points: [self.x, self.y, self.x + self.width, self.y]
                        width: 1

                Widget:
                    size_hint_x: None
                    width: "36dp"

                PLabel:
                    text: ((app.ui_language_code or True) and shape(tr("وضعیت")))
                    font_style: "Caption"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: theme.TEXT_SECONDARY
                    halign: "right"
                    valign: "middle"
                    size_hint_x: 0.14

                PLabel:
                    text: ((app.ui_language_code or True) and shape(tr("دوره‌ها")))
                    font_style: "Caption"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: theme.TEXT_SECONDARY
                    valign: "middle"
                    size_hint_x: 0.18

                PLabel:
                    text: ((app.ui_language_code or True) and shape(tr("بازه")))
                    font_style: "Caption"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: theme.TEXT_SECONDARY
                    valign: "middle"
                    size_hint_x: 0.5

                PLabel:
                    text: ((app.ui_language_code or True) and shape(tr("کد")))
                    font_style: "Caption"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: theme.TEXT_SECONDARY
                    valign: "middle"
                    size_hint_x: 0.18

            RecycleView:
                id: years_list
                viewclass: "FiscalYearRowWidget"
                bar_width: "8dp"
                scroll_type: ["bars", "content"]
                bar_color: theme.ACCENT
                bar_inactive_color: theme.BORDER[0], theme.BORDER[1], theme.BORDER[2], 0.6

                RecycleBoxLayout:
                    orientation: "vertical"
                    default_size_hint: 1, None
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: "0dp"

        PCard:
            size_hint_x: 0.34
            spacing: "14dp"

            PLabel:
                text: ((app.ui_language_code or True) and shape(tr("افزودن سال مالی")))
                font_style: "Subtitle1"
                size_hint_y: None
                height: self.texture_size[1]

            PHintLabel:
                text: ((app.ui_language_code or True) and shape(tr("یک تاریخ در سالِ مالیِ موردنظر را وارد کنید؛ بازه و ۱۲ دوره‌ی ماهانه خودکار ساخته می‌شود.")))

            PTextField:
                id: on_date_field
                hint_text: ((app.ui_language_code or True) and shape(tr("تاریخ (۱۴۰۴/۰۱/۰۱)")))
                persian_digits: True
                on_text_validate: root.save_fiscal_year()
                focus_next: save_button

            Widget:

            PRaisedButton:
                id: save_button
                text: ((app.ui_language_code or True) and shape(tr("افزودن سال مالی")))
                on_release: root.save_fiscal_year()
                focus_previous: on_date_field

            PHintLabel:
                id: status_label
                text: ""

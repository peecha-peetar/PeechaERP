#:import theme peecha.ui.theme

<PlaceholderScreen>:
    name: "placeholder"
    md_bg_color: theme.BACKGROUND

    BoxLayout:
        orientation: "vertical"
        size_hint: None, None
        size: "320dp", "220dp"
        spacing: "14dp"
        pos_hint: {"center_x": 0.5, "center_y": 0.5}

        MDBoxLayout:
            size_hint: None, None
            size: "72dp", "72dp"
            pos_hint: {"center_x": 0.5}
            radius: [26, 26, 26, 26]
            md_bg_color: theme.SELECTED

            MDIcon:
                icon: "hammer-wrench"
                theme_text_color: "Custom"
                text_color: theme.ACCENT
                halign: "center"
                valign: "middle"
                font_size: "32sp"

        PLabel:
            text: root.message
            halign: "center"
            theme_text_color: "Custom"
            text_color: theme.TEXT_SECONDARY
            adaptive_size: True
            pos_hint: {"center_x": 0.5}

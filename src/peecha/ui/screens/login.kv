#:import shape peecha.ui.rtl.shape

<LoginScreen>:
    name: "login"
    md_bg_color: app.theme_cls.bg_normal

    MDCard:
        size_hint: None, None
        size: "360dp", "420dp"
        pos_hint: {"center_x": 0.5, "center_y": 0.5}
        orientation: "vertical"
        padding: "24dp"
        spacing: "16dp"
        elevation: 2
        radius: [12, 12, 12, 12]

        MDLabel:
            text: shape("ورود به پیچا")
            font_name: app.font_name
            font_style: "H5"
            halign: "right"
            size_hint_y: None
            height: self.texture_size[1]

        MDTextField:
            id: username_field
            hint_text: shape("نام کاربری")
            font_name: app.font_name
            halign: "right"
            size_hint_y: None
            height: "48dp"

        MDTextField:
            id: password_field
            hint_text: shape("رمز عبور")
            font_name: app.font_name
            password: True
            halign: "right"
            size_hint_y: None
            height: "48dp"

        MDRaisedButton:
            text: shape("ورود")
            font_name: app.font_name
            pos_hint: {"center_x": 0.5}
            on_release: root.attempt_login()

        MDLabel:
            id: status_label
            text: ""
            font_name: app.font_name
            halign: "right"
            theme_text_color: "Hint"
            size_hint_y: None
            height: self.texture_size[1]

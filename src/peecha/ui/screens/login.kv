#:import shape peecha.ui.rtl.shape

<LoginScreen>:
    name: "login"
    md_bg_color: app.theme_cls.bg_normal

    MDCard:
        size_hint: None, None
        size: "380dp", "560dp"
        pos_hint: {"center_x": 0.5, "center_y": 0.5}
        orientation: "vertical"
        padding: "24dp"
        spacing: "16dp"
        elevation: 2
        radius: [12, 12, 12, 12]

        PTitleLabel:
            text: shape("ورود به پیچا")

        PTextField:
            id: username_field
            hint_text: shape("نام کاربری")

        PTextField:
            id: password_field
            hint_text: shape("رمز عبور")
            password: True

        PRaisedButton:
            text: shape("ورود")
            pos_hint: {"center_x": 0.5}
            on_release: root.attempt_login()

        PHintLabel:
            id: status_label
            text: ""

        PRaisedButton:
            id: bootstrap_button
            text: shape("ساخت اولین کاربر مدیر")
            pos_hint: {"center_x": 0.5}
            opacity: 0
            disabled: True
            size_hint_y: None
            height: "0dp"
            on_release: root.open_admin_bootstrap()

        PFlatButton:
            text: shape("تنظیمات اتصال به دیتابیس")
            pos_hint: {"center_x": 0.5}
            on_release: root.open_connection_settings()

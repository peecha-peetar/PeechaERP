#:import shape peecha.ui.rtl.shape
#:import theme peecha.ui.theme

<LoginScreen>:
    name: "login"
    md_bg_color: theme.BACKGROUND

    BoxLayout:
        orientation: "vertical"
        size_hint: None, None
        size: "380dp", "600dp"
        pos_hint: {"center_x": 0.5, "center_y": 0.5}
        spacing: "20dp"

        Widget:

        MDBoxLayout:
            size_hint: None, None
            size: "64dp", "64dp"
            pos_hint: {"center_x": 0.5}
            radius: [22, 22, 22, 22]
            md_bg_color: theme.PRIMARY

            MDIcon:
                icon: "chart-donut"
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1
                halign: "center"
                valign: "middle"
                font_size: "30sp"

        PTitleLabel:
            text: shape("پیچا")
            halign: "center"
            font_style: "H4"
            size_hint_x: 1

        PCard:
            size_hint_y: None
            height: self.minimum_height

            PTitleLabel:
                text: shape("ورود به سیستم")

            PTextField:
                id: username_field
                hint_text: shape("نام کاربری")
                focus_next: password_field
                on_text_validate: root.attempt_login()

            PTextField:
                id: password_field
                hint_text: shape("رمز عبور")
                password: True
                focus_previous: username_field
                on_text_validate: root.attempt_login()

            PRaisedButton:
                text: shape("ورود")
                pos_hint: {"center_x": 0.5}
                on_release: root.attempt_login()

            PHintLabel:
                id: status_label
                text: ""

            PRaisedButton:
                id: bootstrap_button
                text: shape("ساخت اولین کاربر مدیر")
                pos_hint: {"center_x": 0.5}
                opacity: 0
                disabled: True
                size_hint_y: None
                height: "0dp"
                on_release: root.open_admin_bootstrap()

            PFlatButton:
                text: shape("تنظیمات اتصال به دیتابیس")
                pos_hint: {"center_x": 0.5}
                on_release: root.open_connection_settings()

        Widget:

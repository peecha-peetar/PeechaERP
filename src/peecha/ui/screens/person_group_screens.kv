#:import shape peecha.ui.rtl.shape
#:import tr peecha.ui.i18n.tr
#:import theme peecha.ui.theme
#:import dp kivy.metrics.dp

# نکته‌ی مهمِ RTL: ترتیبِ اعلام عمداً برعکسِ ترتیبِ منطقیِ ستون‌هاست تا
# «نام» (اولین چیزِ خوانده‌شده) راست‌ترین بیفتد. این ردیف بینِ هر سه صفحه
# مشترک است (فهرست فقط کد/نام/وضعیت را نشان می‌دهد).
<PersonRowWidget>:
    orientation: "horizontal"
    size_hint_y: None
    height: "36dp"
    padding: ["10dp", "0dp"]
    md_bg_color: theme.SELECTED if root.selected else (theme.GRID_ROW_ALT if root.zebra else theme.SURFACE)
    canvas.after:
        Color:
            rgba: theme.GRID_BORDER
        Line:
            points: [self.x, self.y, self.x + self.width, self.y]
            width: 1

    MDIconButton:
        icon: "trash-can-outline"
        icon_size: "12sp"
        size_hint_x: None
        width: "36dp"
        theme_text_color: "Custom"
        text_color: theme.DANGER
        on_release: root.request_delete()

    AnchorLayout:
        size_hint_x: 0.16
        anchor_x: "right"
        anchor_y: "center"

        PBadge:
            text: root.status_text
            badge_color: theme.SUCCESS if root.is_active_row else theme.TEXT_DISABLED

    PLabel:
        text: root.code_text
        theme_text_color: "Custom"
        text_color: theme.TEXT_SECONDARY
        valign: "middle"
        size_hint_x: 0.24

    PLabel:
        text: root.name_text
        valign: "middle"
        size_hint_x: 0.6


# قالبِ مشترکِ سه صفحه: کارتِ فهرست (چپ) + کارتِ فرم (راست، داخلِ
# ScrollView چون تعدادِ فیلدهای تکمیلی زیاد است و ممکن است از ارتفاعِ
# صفحه بیشتر شود).
<CustomersScreen>:
    name: "customers"
    md_bg_color: theme.BACKGROUND

    BoxLayout:
        orientation: "horizontal"
        padding: "24dp"
        spacing: "20dp"

        PCard:
            size_hint_x: 0.6

            PLabel:
                text: ((app.ui_language_code or True) and shape(tr("مشتریان")))
                font_style: "H5"
                size_hint_y: None
                height: self.texture_size[1]

            PHintLabel:
                id: status_label
                text: ""

            BoxLayout:
                id: grid_header
                size_hint_y: None
                height: "36dp"
                padding: ["10dp", "0dp"]
                canvas.before:
                    Color:
                        rgba: theme.GRID_HEADER_BG
                    Rectangle:
                        pos: self.pos
                        size: self.size
                    Color:
                        rgba: theme.GRID_BORDER
                    Line:
                        points: [self.x, self.y, self.x + self.width, self.y]
                        width: 1

                Widget:
                    size_hint_x: None
                    width: "36dp"

                PLabel:
                    text: ((app.ui_language_code or True) and shape(tr("وضعیت")))
                    font_style: "Caption"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: theme.TEXT_SECONDARY
                    halign: "right"
                    valign: "middle"
                    size_hint_x: 0.16

                PLabel:
                    text: ((app.ui_language_code or True) and shape(tr("کد")))
                    font_style: "Caption"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: theme.TEXT_SECONDARY
                    valign: "middle"
                    size_hint_x: 0.24

                PLabel:
                    text: ((app.ui_language_code or True) and shape(tr("نام")))
                    font_style: "Caption"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: theme.TEXT_SECONDARY
                    valign: "middle"
                    size_hint_x: 0.6

            RecycleView:
                id: persons_list
                viewclass: "PersonRowWidget"
                bar_width: "8dp"
                scroll_type: ["bars", "content"]
                bar_color: theme.ACCENT
                bar_inactive_color: theme.BORDER[0], theme.BORDER[1], theme.BORDER[2], 0.6

                RecycleBoxLayout:
                    orientation: "vertical"
                    default_size_hint: 1, None
                    size_hint_y: None
                    height: self.minimum_height
                    spacing: "0dp"

        ScrollView:
            size_hint_x: 0.4

            PCard:
                size_hint_y: None
                height: self.minimum_height
                spacing: "12dp"

                PLabel:
                    id: form_title
                    text: ((app.ui_language_code or True) and shape(tr("افزودنِ موردِ تازه")))
                    font_style: "Subtitle1"
                    size_hint_y: None
                    height: self.texture_size[1]

                PTextField:
                    id: name_field
                    hint_text: ((app.ui_language_code or True) and shape(tr("نام مشتری")))
                    focus_next: code_field

                PTextField:
                    id: code_field
                    hint_text: ((app.ui_language_code or True) and shape(tr("کد (مثلاً C001)")))
                    focus_next: economic_code_field
                    focus_previous: name_field
                    on_text_validate: self.focus_next.focus = True

                PTextField:
                    id: economic_code_field
                    hint_text: ((app.ui_language_code or True) and shape(tr("کد اقتصادی")))
                    persian_digits: True
                    focus_next: national_id_field
                    focus_previous: code_field
                    on_text_validate: self.focus_next.focus = True

                PTextField:
                    id: national_id_field
                    hint_text: ((app.ui_language_code or True) and shape(tr("شناسه/کد ملی")))
                    persian_digits: True
                    focus_next: phone_field
                    focus_previous: economic_code_field
                    on_text_validate: self.focus_next.focus = True

                PTextField:
                    id: phone_field
                    hint_text: ((app.ui_language_code or True) and shape(tr("تلفن")))
                    persian_digits: True
                    focus_next: mobile_field
                    focus_previous: national_id_field
                    on_text_validate: self.focus_next.focus = True

                PTextField:
                    id: mobile_field
                    hint_text: ((app.ui_language_code or True) and shape(tr("موبایل")))
                    persian_digits: True
                    focus_next: address_field
                    focus_previous: phone_field
                    on_text_validate: self.focus_next.focus = True

                PTextField:
                    id: address_field
                    hint_text: ((app.ui_language_code or True) and shape(tr("آدرس")))
                    focus_next: credit_limit_field
                    focus_previous: mobile_field
                    on_text_validate: self.focus_next.focus = True

                PTextField:
                    id: credit_limit_field
                    hint_text: ((app.ui_language_code or True) and shape(tr("سقفِ اعتبار")))
                    persian_digits: True
                    focus_next: notes_field
                    focus_previous: address_field
                    on_text_validate: self.focus_next.focus = True

                PTextField:
                    id: notes_field
                    hint_text: ((app.ui_language_code or True) and shape(tr("یادداشت")))
                    focus_previous: credit_limit_field
                    on_text_validate: root.save_person()

                BoxLayout:
                    size_hint_y: None
                    height: "36dp"
                    spacing: "8dp"

                    MDCheckbox:
                        id: active_checkbox
                        active: True
                        size_hint: None, None
                        size: "24dp", "24dp"
                        pos_hint: {"center_y": 0.5}

                    PLabel:
                        text: ((app.ui_language_code or True) and shape(tr("فعال")))
                        valign: "middle"

                BoxLayout:
                    size_hint_y: None
                    height: "40dp"
                    spacing: "8dp"

                    PRaisedButton:
                        id: save_button
                        text: ((app.ui_language_code or True) and shape(tr("افزودن")))
                        on_release: root.save_person()
                        focus_previous: notes_field
                        focus_next: cancel_edit_button

                    PFlatButton:
                        id: cancel_edit_button
                        text: ((app.ui_language_code or True) and shape(tr("لغو ویرایش (Esc)")))
                        theme_text_color: "Custom"
                        text_color: theme.TEXT_SECONDARY
                        opacity: 0
                        disabled: True
                        size_hint_y: None
                        height: "0dp"
                        on_release: root.cancel_edit()
                        focus_previous: save_button


